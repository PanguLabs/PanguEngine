cmake_minimum_required(VERSION 4.0)
foreach(required IN ITEMS PG_SDK_CONFIG_FILE PANGU_META_LLVM_DIR PANGU_META_CLANG_DIR
                          PANGU_META_RESOURCE_DIR PANGU_META_HOST_COMPILER)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "incompatible_sdk: required ${required}")
    endif()
endforeach()
if(NOT IS_ABSOLUTE "${PG_SDK_CONFIG_FILE}")
    message(FATAL_ERROR "incompatible_sdk: PG_SDK_CONFIG_FILE must be absolute")
endif()
get_filename_component(configRoot "${PG_SDK_CONFIG_FILE}" DIRECTORY)
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${CMAKE_CURRENT_LIST_DIR}/.."
    -B "${configRoot}/Check" -G Ninja -DBUILD_TESTING=OFF -DCMAKE_BUILD_TYPE=Release
    -DPANGU_META_SDK_CONFIG:FILEPATH=
    "-DPANGU_META_HOST_COMPILER:FILEPATH=${PANGU_META_HOST_COMPILER}"
    "-DPANGU_META_LLVM_DIR:PATH=${PANGU_META_LLVM_DIR}"
    "-DPANGU_META_CLANG_DIR:PATH=${PANGU_META_CLANG_DIR}"
    "-DPANGU_META_RESOURCE_DIR:PATH=${PANGU_META_RESOURCE_DIR}"
    "-DPANGU_META_SDK_SOURCE_VERSION:STRING=${PANGU_META_SDK_SOURCE_VERSION}"
    "-DPG_SDK_CONFIG_FILE:FILEPATH=${PG_SDK_CONFIG_FILE}"
    COMMAND_ERROR_IS_FATAL ANY)
