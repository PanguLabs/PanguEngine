cmake_minimum_required(VERSION 4.0)

# 仅显式调用；源码检出和下载安装由调用方负责。
foreach(required IN ITEMS PG_LLVM_SOURCE_DIR PG_LLVM_SOURCE_COMMIT PG_SDK_BUILD_ROOT PG_HOST_COMPILER PG_SDK_CONFIG_FILE)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "incompatible_sdk: required ${required}")
    endif()
endforeach()
foreach(path IN ITEMS PG_LLVM_SOURCE_DIR PG_SDK_BUILD_ROOT PG_HOST_COMPILER PG_SDK_CONFIG_FILE)
    if(NOT IS_ABSOLUTE "${${path}}")
        message(FATAL_ERROR "incompatible_sdk: ${path} must be absolute")
    endif()
endforeach()
if(NOT EXISTS "${PG_HOST_COMPILER}" OR IS_DIRECTORY "${PG_HOST_COMPILER}")
    message(FATAL_ERROR "incompatible_sdk: PG_HOST_COMPILER must name an existing compiler")
endif()
execute_process(COMMAND "${PG_HOST_COMPILER}" --version
    OUTPUT_VARIABLE compilerVersion COMMAND_ERROR_IS_FATAL ANY)
if(NOT compilerVersion MATCHES "clang version 23[.]")
    message(FATAL_ERROR "incompatible_sdk: SDK preparation requires host Clang 23.x")
endif()
if(NOT CMAKE_HOST_WIN32)
    file(REAL_PATH "${PG_HOST_COMPILER}" requestedCompiler)
    file(REAL_PATH "$ENV{LLVM_ROOT}/bin/clang++" selectedCompiler)
    if(NOT requestedCompiler STREQUAL selectedCompiler)
        message(FATAL_ERROR "incompatible_sdk: LLVM_ROOT must match PG_HOST_COMPILER")
    endif()
endif()
if(NOT DEFINED PG_BUILD_JOBS)
    set(PG_BUILD_JOBS 2)
endif()
if(NOT PG_BUILD_JOBS MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "PG_BUILD_JOBS must be positive")
endif()
find_package(Git REQUIRED)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${PG_LLVM_SOURCE_DIR}" rev-parse HEAD
    OUTPUT_VARIABLE head OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
if(NOT head STREQUAL PG_LLVM_SOURCE_COMMIT)
    message(FATAL_ERROR "incompatible_sdk: source HEAD ${head} differs from ${PG_LLVM_SOURCE_COMMIT}")
endif()
include("${PG_LLVM_SOURCE_DIR}/cmake/Modules/LLVMVersion.cmake")
if(NOT LLVM_VERSION_MAJOR EQUAL 23)
    message(FATAL_ERROR "incompatible_sdk: LLVM 23.x source required")
endif()
file(REAL_PATH "${PG_LLVM_SOURCE_DIR}" source)
file(REAL_PATH "${PG_SDK_BUILD_ROOT}" binary)
set(sourcePrefix "${source}")
set(binaryPrefix "${binary}")
if(CMAKE_HOST_WIN32)
    string(TOLOWER "${sourcePrefix}" sourcePrefix)
    string(TOLOWER "${binaryPrefix}" binaryPrefix)
endif()
cmake_path(IS_PREFIX sourcePrefix "${binaryPrefix}" NORMALIZE inSource)
if(inSource)
    message(FATAL_ERROR "incompatible_sdk: SDK build must be outside the LLVM source")
endif()
file(MAKE_DIRECTORY "${binary}")
set(identity "${source}\n${head}\n${PG_HOST_COMPILER}\n")
set(marker "${binary}/PanguMetaSdkSource.txt")
if(EXISTS "${marker}")
    file(READ "${marker}" previous)
    if(NOT previous STREQUAL identity)
        message(FATAL_ERROR "incompatible_sdk: SDK build root belongs to another source/compiler")
    endif()
else()
    file(GLOB existing LIST_DIRECTORIES TRUE "${binary}/*" "${binary}/.*")
    if(existing)
        message(FATAL_ERROR "incompatible_sdk: refusing a non-empty SDK build root without its source marker")
    endif()
endif()
file(WRITE "${marker}" "${identity}")
get_filename_component(compilerDir "${PG_HOST_COMPILER}" DIRECTORY)
if(CMAKE_HOST_WIN32)
    set(cCompiler "${compilerDir}/clang.exe")
    set(libcxx OFF)
    set(platformArgs)
else()
    set(cCompiler "${compilerDir}/clang")
    set(libcxx ON)
    if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
        # 上游 LIBCXX 选项追加 -stdlib，与精确头路径的 -nostdinc++ 共存时会产生冗余参数警告。
        # 仅 SDK 配置消除此诊断，避免上游 -Werror 特性探测错误地判定不支持 -fPIC。
        set(platformArgs
            "-DCMAKE_TOOLCHAIN_FILE:FILEPATH=${CMAKE_CURRENT_LIST_DIR}/../../../cmake/Platform/Linux/Toolchain.cmake"
            "-DCMAKE_CXX_FLAGS_INIT:STRING=-Wno-unused-command-line-argument")
    elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
        set(platformArgs "-DCMAKE_TOOLCHAIN_FILE:FILEPATH=${CMAKE_CURRENT_LIST_DIR}/../../../cmake/Platform/macOS/Toolchain.cmake")
    else()
        message(FATAL_ERROR "incompatible_sdk: unsupported host")
    endif()
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${source}/llvm" -B "${binary}" -G Ninja
    "-DCMAKE_C_COMPILER:FILEPATH=${cCompiler}" "-DCMAKE_CXX_COMPILER:FILEPATH=${PG_HOST_COMPILER}"
    -DCMAKE_BUILD_TYPE=Release -DLLVM_ENABLE_PROJECTS=clang "-DLLVM_TARGETS_TO_BUILD=X86;AArch64"
    -DLLVM_ENABLE_RTTI=ON -DLLVM_ENABLE_EH=OFF "-DLLVM_ENABLE_LIBCXX=${libcxx}"
    -DLLVM_INCLUDE_TESTS=OFF -DLLVM_INCLUDE_BENCHMARKS=OFF -DLLVM_INCLUDE_EXAMPLES=OFF
    -DLLVM_ENABLE_ZLIB=OFF -DLLVM_ENABLE_ZSTD=OFF -DLLVM_ENABLE_LIBXML2=OFF
    -DLLVM_PARALLEL_LINK_JOBS=1 ${platformArgs}
    COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${binary}" --target
    llvm-libraries clang-libraries clang-resource-headers --parallel "${PG_BUILD_JOBS}"
    COMMAND_ERROR_IS_FATAL ANY)
set(PANGU_META_LLVM_DIR "${binary}/lib/cmake/llvm")
set(PANGU_META_CLANG_DIR "${binary}/lib/cmake/clang")
set(PANGU_META_RESOURCE_DIR "${binary}/lib/clang/${LLVM_VERSION_MAJOR}")
set(PANGU_META_HOST_COMPILER "${PG_HOST_COMPILER}")
set(PANGU_META_SDK_SOURCE_VERSION "${head}")
include("${CMAKE_CURRENT_LIST_DIR}/Check.cmake")
