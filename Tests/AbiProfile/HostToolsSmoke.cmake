cmake_minimum_required(VERSION 4.0)
foreach(name IN ITEMS PANGU_HOST_SOURCE_ROOT PANGU_HOST_TEST_ROOT)
    if(NOT DEFINED ${name} OR "${${name}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${name}")
    endif()
endforeach()
include("${PANGU_HOST_SOURCE_ROOT}/cmake/HostTools.cmake")
pangu_prepare_host_tools(_tool)
if(NOT EXISTS "${_tool}")
    message(FATAL_ERROR "Host bootstrap returned a missing executable: ${_tool}")
endif()
if(NOT _tool MATCHES "/published/[0-9a-f]+/PanguAbiProfileTool(\\.exe)?$")
    message(FATAL_ERROR "Host tool path is not immutable/versioned: ${_tool}")
endif()
if(DEFINED PANGU_HOST_RESULT_FILE)
    file(WRITE "${PANGU_HOST_RESULT_FILE}" "${_tool}\n")
endif()
