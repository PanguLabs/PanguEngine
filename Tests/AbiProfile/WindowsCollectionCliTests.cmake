cmake_minimum_required(VERSION 4.0)

foreach(required IN ITEMS PANGU_ABI_PROFILE_TOOL PANGU_TEST_OUTPUT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${PANGU_TEST_OUTPUT}")
set(evidence "${PANGU_TEST_OUTPUT}/invalid-evidence.json")
set(profile "${PANGU_TEST_OUTPUT}/profile.json")
foreach(contents IN ITEMS "{}" "{malformed" "{\"schema\":1,\"schema\":1}")
    file(WRITE "${evidence}" "${contents}")
    file(WRITE "${profile}" "stale profile")
    execute_process(COMMAND "${PANGU_ABI_PROFILE_TOOL}" --collect-windows "${evidence}" "${profile}"
        RESULT_VARIABLE result OUTPUT_VARIABLE report ERROR_VARIABLE diagnostic)
    if(result EQUAL 0 OR EXISTS "${profile}")
        message(FATAL_ERROR "Invalid collection evidence accepted or stale profile left: ${diagnostic}")
    endif()
    string(JSON operation GET "${report}" operation)
    string(JSON count LENGTH "${report}" errors)
    if(NOT operation STREQUAL "abi-profile" OR count LESS 1)
        message(FATAL_ERROR "Missing structured collection failure: ${report}")
    endif()
endforeach()

file(WRITE "${profile}" "stale profile")
execute_process(COMMAND "${PANGU_ABI_PROFILE_TOOL}" --collect-windows "${PANGU_TEST_OUTPUT}/missing.json" "${profile}"
    RESULT_VARIABLE result OUTPUT_VARIABLE report ERROR_VARIABLE diagnostic)
if(result EQUAL 0 OR EXISTS "${profile}")
    message(FATAL_ERROR "Missing evidence did not invalidate old profile: ${diagnostic}")
endif()

file(WRITE "${evidence}" "preserve original input")
execute_process(COMMAND "${PANGU_ABI_PROFILE_TOOL}" --collect-windows "${evidence}" "${evidence}"
    RESULT_VARIABLE result OUTPUT_VARIABLE report ERROR_VARIABLE diagnostic)
file(READ "${evidence}" remaining)
if(result EQUAL 0 OR NOT remaining STREQUAL "preserve original input")
    message(FATAL_ERROR "Output alias corrupted collection input: ${diagnostic}")
endif()

set(blocked "${PANGU_TEST_OUTPUT}/blocked")
file(MAKE_DIRECTORY "${blocked}")
file(WRITE "${blocked}/keep.txt" "nonempty output directory")
execute_process(COMMAND "${PANGU_ABI_PROFILE_TOOL}" --collect-windows "${evidence}" "${blocked}"
    RESULT_VARIABLE result OUTPUT_VARIABLE report ERROR_VARIABLE diagnostic)
string(JSON incomplete GET "${report}" cleanup_incomplete)
if(result EQUAL 0 OR NOT incomplete)
    message(FATAL_ERROR "Failed output invalidation did not report cleanup_incomplete: ${report}")
endif()
