cmake_minimum_required(VERSION 4.0)

foreach(required IN ITEMS PANGU_ABI_REQUEST PANGU_COLLECT_SCRIPT PANGU_TEST_OUTPUT PANGU_CASE)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing collection regression input ${required}")
    endif()
endforeach()
function(json_text out value)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(REPLACE "\t" "\\t" value "${value}")
    set(${out} "\"${value}\"" PARENT_SCOPE)
endfunction()
file(READ "${PANGU_ABI_REQUEST}" request)
string(JSON originalDatabase GET "${request}" database)
string(JSON objectFile GET "${request}" objects_file)
if(PANGU_CASE STREQUAL "STL_CONFIG")
    set(objectFile "${PANGU_STL_OBJECTS}")
    json_text(encoded "${objectFile}")
    string(JSON request SET "${request}" objects_file "${encoded}")
endif()
string(JSON originalOutput GET "${request}" output_directory)
file(STRINGS "${objectFile}" objects)
list(LENGTH objects objectCount)
if(NOT objectCount EQUAL 2)
    message(FATAL_ERROR "The collection fixture must have two actual translation units")
endif()
list(GET objects 1 selectedObject)
file(TO_CMAKE_PATH "${selectedObject}" selectedObject)
cmake_path(NORMAL_PATH selectedObject)
string(TOLOWER "${selectedObject}" selectedObject)
file(READ "${originalDatabase}" database)
string(JSON count LENGTH "${database}")
math(EXPR last "${count} - 1")
set(selectedIndex -1)
foreach(index RANGE 0 ${last})
    string(JSON object GET "${database}" ${index} output)
    file(TO_CMAKE_PATH "${object}" object)
    cmake_path(NORMAL_PATH object)
    string(TOLOWER "${object}" object)
    if(object STREQUAL selectedObject)
        set(selectedIndex "${index}")
    endif()
endforeach()
if(selectedIndex EQUAL -1)
    message(FATAL_ERROR "Cannot find fixture second object in compile database")
endif()
set(output "${PANGU_TEST_OUTPUT}/${PANGU_CASE}")
file(MAKE_DIRECTORY "${output}")
if(PANGU_CASE STREQUAL "MISSING")
    string(JSON database REMOVE "${database}" ${selectedIndex})
elseif(PANGU_CASE STREQUAL "DUPLICATE")
    string(JSON entry GET "${database}" ${selectedIndex})
    string(JSON database SET "${database}" ${count} "${entry}")
elseif(PANGU_CASE STREQUAL "RTTI" OR PANGU_CASE STREQUAL "UNKNOWN"
        OR PANGU_CASE STREQUAL "RESPONSE" OR PANGU_CASE STREQUAL "MISSING_RESPONSE")
    string(JSON command GET "${database}" ${selectedIndex} command)
    if(PANGU_CASE STREQUAL "RTTI")
        file(READ "${originalOutput}/profile.json" baselineProfile)
        string(JSON rtti GET "${baselineProfile}" language rtti)
        if(rtti STREQUAL "off")
            string(APPEND command " -frtti")
        else()
            string(APPEND command " -fno-rtti")
        endif()
    elseif(PANGU_CASE STREQUAL "UNKNOWN")
        string(APPEND command " -fpack-struct=1")
    else()
        if(PANGU_CASE STREQUAL "RESPONSE")
            file(WRITE "${output}/inner.rsp" "-Wno-unused-variable\n")
            file(WRITE "${output}/outer.rsp" "@\"${output}/inner.rsp\"\n")
        endif()
        string(APPEND command " @\"${output}/outer.rsp\"")
    endif()
    json_text(encoded "${command}")
    string(JSON database SET "${database}" ${selectedIndex} command "${encoded}")
elseif(NOT PANGU_CASE STREQUAL "BASELINE" AND NOT PANGU_CASE STREQUAL "STL_CONFIG")
    message(FATAL_ERROR "Unknown collection regression ${PANGU_CASE}")
endif()
file(WRITE "${output}/database.json" "${database}\n")
json_text(encoded "${output}/database.json")
string(JSON request SET "${request}" database "${encoded}")
json_text(encoded "${output}")
string(JSON request SET "${request}" output_directory "${encoded}")
file(WRITE "${output}/request.json" "${request}\n")
foreach(name IN ITEMS profile.json canonical.json fingerprint.sha256 evidence.json compiler-evidence.json)
    file(WRITE "${output}/${name}" "stale output")
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" "-DPANGU_ABI_REQUEST=${output}/request.json" -P "${PANGU_COLLECT_SCRIPT}"
    RESULT_VARIABLE result OUTPUT_VARIABLE diagnostic ERROR_VARIABLE errors)
if(PANGU_CASE STREQUAL "BASELINE" OR PANGU_CASE STREQUAL "RESPONSE")
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Collection ${PANGU_CASE} failed: ${diagnostic}\n${errors}")
    endif()
    file(READ "${output}/compiler-evidence.json" evidence)
    string(JSON units LENGTH "${evidence}" units)
    if(NOT units EQUAL 2)
        message(FATAL_ERROR "Collector did not cover both fixture TUs")
    endif()
    file(READ "${output}/fingerprint.sha256" digest)
    string(LENGTH "${digest}" length)
    if(NOT length EQUAL 64 OR NOT digest MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "Collection did not produce a valid fingerprint")
    endif()
else()
    if(result EQUAL 0)
        message(FATAL_ERROR "Invalid collection ${PANGU_CASE} accepted")
    endif()
    foreach(name IN ITEMS profile.json canonical.json fingerprint.sha256 evidence.json compiler-evidence.json)
        if(EXISTS "${output}/${name}")
            message(FATAL_ERROR "Failure ${PANGU_CASE} left stale ${name}: ${diagnostic}\n${errors}")
        endif()
    endforeach()
endif()
