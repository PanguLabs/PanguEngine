include_guard(GLOBAL)

# 仅记录命令元数据，不包装 execute_process，保留调用方原有输出与失败判断。
function(_pangu_record_test_command_time started result)
    string(TIMESTAMP finished "%s%f" UTC)
    math(EXPR elapsed "${finished} - ${started}")
    set(phase run)
    if("--build" IN_LIST ARGN)
        set(phase build)
    elseif("-S" IN_LIST ARGN)
        set(phase configure)
    elseif("--test-dir" IN_LIST ARGN)
        set(phase test)
        if("-N" IN_LIST ARGN OR "--show-only=json-v1" IN_LIST ARGN)
            set(phase discovery)
        endif()
    endif()
    set(log "${PANGU_TEST_ROOT}/command-times.tsv")
    if(NOT EXISTS "${log}")
        file(WRITE "${log}" "phase\telapsed_us\tresult\tcommand\n")
    endif()
    file(APPEND "${log}" "${phase}\t${elapsed}\t${result}\t${ARGN}\n")
endfunction()
