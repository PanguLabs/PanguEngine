cmake_minimum_required(VERSION 4.0)

if(NOT PANGU_SOURCE_ROOT OR NOT PANGU_TEST_ROOT)
    message(FATAL_ERROR "FindPackage tests require PANGU_SOURCE_ROOT and PANGU_TEST_ROOT")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef runId)
set(root "${PANGU_TEST_ROOT}/${runId}/Package Discovery")
file(MAKE_DIRECTORY "${root}")
set(project [=[
cmake_minimum_required(VERSION 4.0)
project(PackageDiscovery LANGUAGES NONE)
set(BUILD_TESTING OFF)
list(PREPEND CMAKE_MODULE_PATH "@PANGU_SOURCE_ROOT@/cmake")
if(SCENARIO MATCHES "^Invalid")
    set(PANGU_ENGINE_SOURCE_DIR "${CMAKE_BINARY_DIR}/missing engine")
endif()
if(SCENARIO STREQUAL "Explicit")
    set(PANGU_ENGINE_SOURCE_DIR "@PANGU_SOURCE_ROOT@")
endif()
if(SCENARIO STREQUAL "InvalidQuiet")
    find_package(PanguEngine QUIET MODULE)
    if(PanguEngine_FOUND OR TARGET Pangu::Foundation OR COMMAND pangu_initialize)
        message(FATAL_ERROR "An invalid optional Engine must remain unavailable")
    endif()
    unset(PANGU_ENGINE_SOURCE_DIR)
endif()
find_package(PanguEngine REQUIRED MODULE)
find_package(PanguEngine REQUIRED MODULE)
file(REAL_PATH "@PANGU_SOURCE_ROOT@" expectedSource)
if(NOT PanguEngine_FOUND OR NOT COMMAND pangu_initialize OR
   NOT PANGU_ENGINE_SOURCE_DIR STREQUAL expectedSource)
    message(FATAL_ERROR "Package discovery did not expose the selected source Engine")
endif()
get_property(targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
if(targets OR TARGET Pangu::Foundation OR BUILD_TESTING OR
   NOT CMAKE_PROJECT_NAME STREQUAL "PackageDiscovery" OR
   EXISTS "${CMAKE_BINARY_DIR}/Generated/BuildContext/CurrentProject.json" OR
   EXISTS "${CMAKE_BINARY_DIR}/BuildTools")
    message(FATAL_ERROR "Package discovery must not initialize or build the Engine")
endif()
if(SCENARIO STREQUAL "RelativeBuildRoot")
    set(PANGU_ENGINE_BUILD_ROOT relative)
    pangu_initialize()
endif()
]=])
string(CONFIGURE "${project}" project @ONLY)
file(WRITE "${root}/CMakeLists.txt" "${project}")

foreach(scenario IN ITEMS Implicit Explicit InvalidQuiet InvalidRequired RelativeBuildRoot)
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${root}" -B "${root}/${scenario}" -G Ninja
        "-DSCENARIO=${scenario}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(WRITE "${root}/${scenario}.log" "exit=${result}\n${output}\n${error}")
    set(expectedDiagnostic "")
    if(scenario STREQUAL "InvalidRequired")
        set(expectedDiagnostic "Could NOT find PanguEngine")
    elseif(scenario STREQUAL "RelativeBuildRoot")
        set(expectedDiagnostic "Pangu Engine build root must be absolute")
    endif()
    if(expectedDiagnostic)
        string(FIND "${output}\n${error}" "${expectedDiagnostic}" found)
        if(result EQUAL 0 OR found LESS 0)
            message(FATAL_ERROR "${scenario}: expected failure '${expectedDiagnostic}':\n${output}\n${error}")
        endif()
    elseif(NOT result EQUAL 0)
        message(FATAL_ERROR "${scenario}: package discovery failed:\n${output}\n${error}")
    endif()
endforeach()
message(STATUS "PanguEngine package discovery: all 5 scenarios passed")
