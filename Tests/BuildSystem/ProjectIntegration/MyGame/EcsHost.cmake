if(NOT TARGET MyGameEcsGameplay OR NOT TARGET MyGameEcsConsumer)
    message(FATAL_ERROR "MyGameEcsHost requires the mygame.gameplay fixture Plugin")
endif()
if(ANDROID)
    add_library(MyGameEcsHost SHARED Source/EcsHost.cpp)
    set_target_properties(MyGameEcsHost PROPERTIES LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/Bin")
    add_executable(MyGameEcsHostCaller Source/EcsMain.cpp)
    target_link_libraries(MyGameEcsHostCaller PRIVATE PanguBuildOptions MyGameEcsHost)
    set(callerArtifact "set(caller [==[$<TARGET_FILE:MyGameEcsHostCaller>]==])\n")
else()
    add_executable(MyGameEcsHost Source/EcsMain.cpp Source/EcsHost.cpp)
endif()
target_link_libraries(MyGameEcsHost PRIVATE PanguBuildOptions MyGameEcsHeaders Pangu::ECS)
if(PANGU_LINK_MODE STREQUAL "Monolithic")
    pangu_meta_host_catalog(TARGET MyGameEcsHost MODULES MyGameEcsGameplay MyGameEcsConsumer)
    target_link_libraries(MyGameEcsHost PRIVATE MyGameEcsGameplay MyGameEcsConsumer)
    if(WIN32)
        # PE Release 可执行文件不保留 COFF 符号表，使用链接器实际保留符号的映射。
        target_link_options(MyGameEcsHost PRIVATE "LINKER:/MAP:${CMAKE_CURRENT_BINARY_DIR}/MyGameEcsHost.map")
    endif()
else()
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        set_target_properties(MyGameEcsHost PROPERTIES ENABLE_EXPORTS ON)
    endif()
    # 使用实际目标路径，保留共享库自己的运行时依赖搜索路径。
    set(gameplayPath "$<TARGET_FILE:MyGameEcsGameplay>")
    set(consumerPath "$<TARGET_FILE:MyGameEcsConsumer>")
    configure_file(Source/EcsCandidates.h.in Generated/EcsCandidates.h.in @ONLY)
    file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/Generated/EcsCandidates.h"
        INPUT "${CMAKE_CURRENT_BINARY_DIR}/Generated/EcsCandidates.h.in")
    target_include_directories(MyGameEcsHost PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/Generated")
    target_compile_definitions(MyGameEcsHost PRIVATE PANGU_FIXTURE_MODULAR)
    add_dependencies(MyGameEcsHost MyGameEcsGameplay MyGameEcsConsumer)
endif()
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/EcsArtifacts.cmake" CONTENT
"set(host [==[$<TARGET_FILE:MyGameEcsHost>]==])
set(gameplay [==[$<TARGET_FILE:MyGameEcsGameplay>]==])
set(consumer [==[$<TARGET_FILE:MyGameEcsConsumer>]==])
set(ecs [==[$<TARGET_FILE:Pangu::ECS>]==])
set(flecs [==[$<TARGET_FILE:ThirdParty::Flecs>]==])
${callerArtifact}")
pangu_stage_host_runtime(TARGET MyGameEcsHost)
