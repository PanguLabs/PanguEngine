#pragma once

#include <EcsFixtureTypes.h>
#include <ModuleManager.h>
#include <array>
#include <filesystem>

namespace pg::fixture::ecs
{
[[nodiscard]] inline auto EcsCandidates()
{
    return std::array<module::ModuleLoadCandidate, 2>{
        module::SharedModuleCandidate{
            .ExpectedId = kEcsGameplayId,
            .Path = std::filesystem::path{R"(@gameplayPath@)"},
        },
        module::SharedModuleCandidate{
            .ExpectedId = kEcsConsumerId,
            .Path = std::filesystem::path{R"(@consumerPath@)"},
        },
    };
}
} // namespace pg::fixture::ecs
