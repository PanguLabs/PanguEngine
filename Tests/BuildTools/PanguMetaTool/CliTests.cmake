cmake_minimum_required(VERSION 4.0)
set(args)
if(PG_TOOLCHAIN)
    list(APPEND args "-DCMAKE_TOOLCHAIN_FILE=${PG_TOOLCHAIN}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${PG_SOURCE}/Fixtures/Consumer" -B "${PG_BINARY}" -G Ninja
    "-DCMAKE_CXX_COMPILER=${PG_COMPILER}" -DCMAKE_BUILD_TYPE=Release
    "-DPG_ENGINE=${PG_ENGINE}" "-DPG_RESOURCE=${PG_RESOURCE}" ${args}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Consumer configure failed: ${output}\n${error}")
endif()
foreach(mode IN ITEMS Typed Both Description Check)
    execute_process(COMMAND "${PG_TOOL}" generate --request "${PG_BINARY}/${mode}.json"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0 OR NOT output STREQUAL "" OR NOT error STREQUAL "")
        message(FATAL_ERROR "Real scan ${mode} must succeed silently: ${result}: ${output}\n${error}")
    endif()
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${PG_BINARY}" --target ConsumerTyped ConsumerBoth ConsumerDescription
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Generated consumer build failed: ${output}\n${error}")
endif()
foreach(mode IN ITEMS Typed Both Description)
    file(READ "${PG_BINARY}/${mode}.exe.path" executable)
    execute_process(COMMAND "${executable}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Consumer ${mode} failed: ${result} ${output}\n${error}")
    endif()
endforeach()
foreach(kind IN ITEMS Const ReadOnly Private ConstOwner)
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${PG_BINARY}" --target "Reject${kind}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    set(diagnostic "${output}\n${error}")
    if(result EQUAL 0 OR diagnostic MATCHES "file not found|cannot open.*file")
        message(FATAL_ERROR "Invalid compile-fail result for ${kind}: ${diagnostic}")
    endif()
    if(kind STREQUAL "Private")
        set(expected "'Secret' is a private member")
    elseif(kind STREQUAL "Const")
        set(expected "!std::is_const_v")
    elseif(kind STREQUAL "ReadOnly")
        set(expected "!true.*evaluated to false")
    else()
        set(expected "would lose const qualifier")
    endif()
    if(NOT diagnostic MATCHES "${expected}")
        message(FATAL_ERROR "Wrong compile-fail diagnostic for ${kind}: ${diagnostic}")
    endif()
endforeach()
set(root "${PG_BINARY}/Generated/PanguMeta/Release")
if(EXISTS "${root}/ActorTyped/Private/ModuleMeta.gen.cpp" OR EXISTS "${root}/ActorTyped/Private/Actor.gen.cpp")
    message(FATAL_ERROR "Typed-only must not generate runtime tables")
endif()
file(GLOB_RECURSE checked "${root}/ActorCheck/*.gen.h" "${root}/ActorCheck/*.gen.cpp")
if(checked)
    message(FATAL_ERROR "Check-only generated target C++: ${checked}")
endif()
set(stable "${root}/ActorBoth/Public/Actor.gen.h")
file(SHA256 "${stable}" before)
file(TIMESTAMP "${stable}" beforeTime "%s")
file(GLOB_RECURSE stableFiles "${root}/ActorBoth/*.gen.h" "${root}/ActorBoth/*.gen.cpp")
set(beforeHashes)
set(beforeTimes)
foreach(path IN LISTS stableFiles)
    file(SHA256 "${path}" hash)
    file(TIMESTAMP "${path}" timestamp "%s")
    list(APPEND beforeHashes "${hash}")
    list(APPEND beforeTimes "${timestamp}")
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1)
execute_process(COMMAND "${PG_TOOL}" generate --request "${PG_BINARY}/Both.json" COMMAND_ERROR_IS_FATAL ANY)
file(SHA256 "${stable}" after)
file(TIMESTAMP "${stable}" afterTime "%s")
if(NOT before STREQUAL after OR NOT beforeTime STREQUAL afterTime)
    message(FATAL_ERROR "Unchanged generation changed bytes/mtime")
endif()
set(index 0)
foreach(path IN LISTS stableFiles)
    file(SHA256 "${path}" hash)
    file(TIMESTAMP "${path}" timestamp "%s")
    list(GET beforeHashes ${index} expectedHash)
    list(GET beforeTimes ${index} expectedTime)
    if(NOT hash STREQUAL expectedHash OR NOT timestamp STREQUAL expectedTime)
        message(FATAL_ERROR "Unchanged generation changed bytes/mtime: ${path}")
    endif()
    math(EXPR index "${index} + 1")
endforeach()
file(READ "${root}/ActorBoth/Meta.d" depfile)
foreach(dependency IN ITEMS Both.json compile_commands.json CMakeCache.txt options.rsp Actor.h MetaOptions.h PanguMetaTool)
    if(NOT depfile MATCHES "${dependency}")
        message(FATAL_ERROR "Missing dependency: ${dependency}")
    endif()
endforeach()
file(GLOB_RECURSE generated "${root}/*.gen.h" "${root}/*.gen.cpp")
foreach(path IN LISTS generated)
    file(READ "${path}" content)
    string(FIND "${content}" "${PG_ENGINE}" found)
    if(NOT found EQUAL -1)
        message(FATAL_ERROR "Generated C++ leaked absolute path: ${path}")
    endif()
endforeach()
# scan 与 Query 同批发布，随后独立 Query/Catalog 使用不同目标的状态。
file(READ "${PG_BINARY}/Both.json" request)
string(JSON request SET "${request}" outputs 8 "\"Private/ModuleQuery.gen.cpp\"")
file(WRITE "${PG_BINARY}/MergedQuery.json" "${request}")
execute_process(COMMAND "${PG_TOOL}" generate --request "${PG_BINARY}/MergedQuery.json"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT error STREQUAL "" OR NOT output STREQUAL "")
    message(FATAL_ERROR "Merged Query emission failed: ${result} ${output}${error}")
endif()
foreach(kind IN ITEMS query catalog)
    string(JSON assembly SET "${request}" kind "\"${kind}\"")
    string(JSON assembly SET "${assembly}" target "\"Assembly${kind}\"")
    string(JSON assembly SET "${assembly}" output_root "\"${root}/Assembly${kind}\"")
    string(JSON assembly SET "${assembly}" headers "[]")
    string(JSON assembly SET "${assembly}" context "{}")
    if(kind STREQUAL "query")
        string(JSON assembly SET "${assembly}" outputs "[\"Private/ModuleQuery.gen.cpp\"]")
    else()
        string(JSON assembly SET "${assembly}" module "{}")
        string(JSON assembly SET "${assembly}" outputs "[\"Private/StaticModuleCatalog.gen.cpp\"]")
    endif()
    file(WRITE "${PG_BINARY}/${kind}.json" "${assembly}")
    execute_process(COMMAND "${PG_TOOL}" generate --request "${PG_BINARY}/${kind}.json"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0 OR NOT error STREQUAL "" OR NOT output STREQUAL "")
        message(FATAL_ERROR "Assembly ${kind} emission failed: ${result} ${output}${error}")
    endif()
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${PG_BINARY}" --target Assemblyquery Assemblycatalog
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Assembly-only generated sources failed to compile: ${output}${error}")
endif()
file(READ "${root}/ActorBoth/Meta.stamp" stampBefore)
file(WRITE "${PG_BINARY}/options.rsp" "-DPG_TEST_RSP=62\n")
execute_process(COMMAND "${PG_TOOL}" generate --request "${PG_BINARY}/Both.json"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
file(WRITE "${PG_BINARY}/options.rsp" "-DPG_TEST_RSP=61\n")
if(NOT result EQUAL 1 OR NOT error MATCHES "invalid_context.*static assertion failed" OR NOT output STREQUAL "")
    message(FATAL_ERROR "Semantic error must stop generation: ${result} ${output}${error}")
endif()
file(READ "${root}/ActorBoth/Meta.stamp" stampAfter)
file(SHA256 "${stable}" unchanged)
if(NOT before STREQUAL unchanged OR NOT stampBefore STREQUAL stampAfter)
    message(FATAL_ERROR "Semantic failure published partial output")
endif()
