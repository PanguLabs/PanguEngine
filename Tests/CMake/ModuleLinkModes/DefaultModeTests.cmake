cmake_minimum_required(VERSION 4.0)
include("${PANGU_SOURCE_ROOT}/cmake/PanguLinkMode.cmake")
pangu_initialize_link_mode()
pangu_module_library_type(actualType)
if(CMAKE_SYSTEM_NAME STREQUAL "Android" OR CMAKE_SYSTEM_NAME STREQUAL "iOS")
    set(expectedMode Monolithic)
    set(expectedType STATIC)
else()
    set(expectedMode Modular)
    set(expectedType SHARED)
endif()
if(NOT PANGU_LINK_MODE STREQUAL expectedMode OR NOT actualType STREQUAL expectedType)
    message(FATAL_ERROR "Incorrect default mode for ${CMAKE_SYSTEM_NAME}: ${PANGU_LINK_MODE}/${actualType}")
endif()
