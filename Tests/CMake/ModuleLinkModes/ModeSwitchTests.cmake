include("${CMAKE_CURRENT_LIST_DIR}/Helpers.cmake")
if(CMAKE_HOST_WIN32)
    set(CMAKE_EXECUTABLE_SUFFIX .exe)
endif()
foreach(mode IN ITEMS Modular Monolithic Modular)
    Configure(Switch PASS "" "-DPANGU_LINK_MODE=${mode}" "-DEXPECT_MODE=${mode}")
    BuildAndRun(Switch)
    Run(PASS "ModeConsumerSmoke" "${CMAKE_CTEST_COMMAND}" --test-dir "${PANGU_TEST_ROOT}/Switch" -N)
    if(mode STREQUAL "Modular" AND NOT commandOutput MATCHES "QueryFirstSmoke")
        message(FATAL_ERROR "Modular Query smoke tests are missing")
    elseif(mode STREQUAL "Monolithic" AND commandOutput MATCHES "QueryFirstSmoke")
        message(FATAL_ERROR "Monolithic retained stale Modular Query tests")
    endif()
    Run(PASS "100% tests passed" "${CMAKE_CTEST_COMMAND}" --test-dir "${PANGU_TEST_ROOT}/Switch"
        --output-on-failure --no-tests=error)
endforeach()
