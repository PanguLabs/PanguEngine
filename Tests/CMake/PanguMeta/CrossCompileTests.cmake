cmake_minimum_required(VERSION 4.0)
foreach(input IN ITEMS PANGU_ENGINE_SOURCE_DIR PANGU_TEST_ROOT PANGU_TARGET_PRESET PANGU_LINK_MODE
        PANGU_META_HOST_TOOL PANGU_ENGINE_ALLOW_LOCAL_OVERRIDE)
    if(NOT DEFINED ${input} OR "${${input}}" STREQUAL "")
        message(FATAL_ERROR "Mobile acceptance requires ${input}")
    endif()
endforeach()
if(NOT PANGU_TARGET_PRESET MATCHES "^(android-arm64|ios-arm64)$" OR
   NOT PANGU_LINK_MODE MATCHES "^(Monolithic|Modular)$")
    message(FATAL_ERROR "Mobile acceptance requires ARM64 and a supported link mode")
endif()
file(MAKE_DIRECTORY "${PANGU_TEST_ROOT}")
set(binary "${PANGU_TEST_ROOT}/${PANGU_TARGET_PRESET}-${PANGU_LINK_MODE}")
set(logIndex 0)
function(MobileCommand)
    math(EXPR logIndex "${logIndex}+1")
    execute_process(COMMAND ${ARGV} WORKING_DIRECTORY "${PANGU_ENGINE_SOURCE_DIR}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(WRITE "${PANGU_TEST_ROOT}/${PANGU_TARGET_PRESET}-${PANGU_LINK_MODE}-${logIndex}.log"
        "${ARGV}\nexit=${result}\n${output}\n${error}")
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Mobile command failed (${result}): ${ARGV}\n${output}\n${error}")
    endif()
    set(logIndex "${logIndex}" PARENT_SCOPE)
    set(commandOutput "${output}\n${error}" PARENT_SCOPE)
endfunction()
MobileCommand("${PANGU_META_HOST_TOOL}" --check-clang)
# 根 preset 是目标工具链的权威来源；夹具转发其实际 cache，避免第二套 SDK 配置。
MobileCommand("${CMAKE_COMMAND}" --preset "${PANGU_TARGET_PRESET}"
    "-DPANGU_LINK_MODE=${PANGU_LINK_MODE}" -DBUILD_TESTING=OFF

    "-DPANGU_ENGINE_ALLOW_LOCAL_OVERRIDE=${PANGU_ENGINE_ALLOW_LOCAL_OVERRIDE}")
MobileCommand("${CMAKE_COMMAND}" --build --preset "${PANGU_TARGET_PRESET}" --parallel 4)
if(PANGU_TARGET_PRESET STREQUAL "android-arm64")
    set(root "${PANGU_ENGINE_SOURCE_DIR}/Build/Android")
else()
    set(root "$ENV{HOME}/PanguEngineBuild/iOS")
endif()
load_cache("${root}" READ_WITH_PREFIX ROOT_
    CMAKE_TOOLCHAIN_FILE CMAKE_BUILD_TYPE CMAKE_ANDROID_NDK ANDROID_ABI ANDROID_PLATFORM ANDROID_STL
    CMAKE_OSX_ARCHITECTURES CMAKE_OSX_DEPLOYMENT_TARGET CMAKE_OSX_SYSROOT)
set(arguments)
foreach(key IN ITEMS CMAKE_TOOLCHAIN_FILE CMAKE_BUILD_TYPE CMAKE_ANDROID_NDK ANDROID_ABI ANDROID_PLATFORM
        ANDROID_STL CMAKE_OSX_ARCHITECTURES CMAKE_OSX_DEPLOYMENT_TARGET CMAKE_OSX_SYSROOT)
    if(NOT "${ROOT_${key}}" STREQUAL "")
        list(APPEND arguments "-D${key}=${ROOT_${key}}")
    endif()
endforeach()
MobileCommand("${CMAKE_COMMAND}" -S "${CMAKE_CURRENT_LIST_DIR}/Fixtures/Mobile" -B "${binary}" -G Ninja
    ${arguments} "-DPANGU_ENGINE_SOURCE_DIR=${PANGU_ENGINE_SOURCE_DIR}"
     "-DPANGU_META_HOST_TOOL=${PANGU_META_HOST_TOOL}"
    "-DPANGU_LINK_MODE=${PANGU_LINK_MODE}")
MobileCommand("${CMAKE_COMMAND}" --build "${binary}" --parallel 4)
file(STRINGS "${binary}/Artifacts.txt" artifacts)
if(NOT artifacts)
    message(FATAL_ERROR "Mobile fixture produced no final link artifacts")
endif()
foreach(module IN ITEMS PanguFoundation PanguModule PanguEngineHost)
    if(PANGU_LINK_MODE STREQUAL "Monolithic")
        list(APPEND artifacts "${root}/Lib/lib${module}.a")
    elseif(PANGU_TARGET_PRESET STREQUAL "android-arm64")
        list(APPEND artifacts "${root}/Bin/lib${module}.so")
    else()
        list(APPEND artifacts "${root}/Bin/lib${module}.dylib")
    endif()
endforeach()
file(READ "${binary}/compile_commands.json" commands)
if(PANGU_TARGET_PRESET STREQUAL "android-arm64")
    file(TO_CMAKE_PATH "${ROOT_CMAKE_ANDROID_NDK}" ndk)
    string(FIND "${commands}" "--sysroot=${ndk}/toolchains/llvm/" sdkPosition)
    if(NOT commands MATCHES "aarch64[^ ]*android29" OR sdkPosition LESS 0)
        message(FATAL_ERROR "Mobile compilation database does not use the preset Android ARM64/API29/NDK")
    endif()
else()
    string(FIND "${commands}" "${ROOT_CMAKE_OSX_SYSROOT}" sdkPosition)
    if(NOT commands MATCHES "arm64" OR sdkPosition LESS 0)
        message(FATAL_ERROR "Mobile compilation database does not use the preset ARM64/iPhoneOS SDK")
    endif()
endif()
file(GLOB_RECURSE objects "${binary}/CMakeFiles/MobileMeta.dir/*.o" "${binary}/CMakeFiles/MobileConsume.dir/*.o")
if(NOT objects)
    message(FATAL_ERROR "Mobile fixture produced no actual target objects")
endif()
list(APPEND artifacts ${objects})
if(CMAKE_HOST_WIN32)
    set(suffix .exe)
endif()
foreach(artifact IN LISTS artifacts)
    if(NOT EXISTS "${artifact}")
        message(FATAL_ERROR "Missing final link artifact: ${artifact}")
    endif()
    if(PANGU_TARGET_PRESET STREQUAL "android-arm64")
        MobileCommand("$ENV{LLVM_ROOT}/bin/llvm-readobj${suffix}" --file-headers --needed-libs "${artifact}")
        if(NOT commandOutput MATCHES "Arch: aarch64")
            message(FATAL_ERROR "Expected AArch64 ELF: ${commandOutput}")
        endif()
    else()
        MobileCommand("$ENV{LLVM_ROOT}/bin/llvm-readobj" --file-headers "${artifact}")
        if(NOT commandOutput MATCHES "Arch: aarch64")
            message(FATAL_ERROR "Expected ARM64 Mach-O/archive: ${commandOutput}")
        endif()
        MobileCommand(otool -l "${artifact}")
        if(NOT commandOutput MATCHES "platform (2|IOS)")
            message(FATAL_ERROR "Expected iOS device load command: ${commandOutput}")
        endif()
        MobileCommand(otool -L "${artifact}")
    endif()
    if(commandOutput MATCHES "LLVM|clang|msvcp|vcruntime|libstdc\\+\\+|/opt/local")
        message(FATAL_ERROR "Host compiler/STL leaked into target dependencies: ${commandOutput}")
    endif()
endforeach()
file(STRINGS "${binary}/build.ninja" linkLines REGEX "^  LINK_LIBRARIES =")
foreach(line IN LISTS linkLines)
    if(line MATCHES "LLVM|clang|msvcp|vcruntime")
        message(FATAL_ERROR "Host libraries leaked into target link command: ${line}")
    endif()
endforeach()
MobileCommand("${CMAKE_COMMAND}" --build "${binary}" --parallel 4)
if(NOT commandOutput MATCHES "no work to do")
    message(FATAL_ERROR "Final mobile build is not a no-op: ${commandOutput}")
endif()
message(STATUS "${PANGU_TARGET_PRESET} ${PANGU_LINK_MODE}: target constants, final link, architecture, dependencies and no-op passed; no device execution")
