cmake_minimum_required(VERSION 4.0)
include("${CMAKE_CURRENT_LIST_DIR}/ConsumerTestHelpers.cmake")
# 可变输入仅复制独立宿主 Tool；支持头和 Runtime 仍读取真实 Engine 源根。
set(toolSource "${PANGU_TEST_ROOT}/ToolSource")
file(COPY "${PANGU_ENGINE_SOURCE_DIR}/BuildTools/PanguMetaTool/" DESTINATION "${toolSource}")
file(WRITE "${toolSource}/Private/Unused.h" "// 只登记为宿主输入，未被编译单元引用。\n")
set(PANGU_META_HOST_BUILD_ROOT "${PANGU_TEST_ROOT}/Host")
set(metaArguments "-DPANGU_META_TOOL_SOURCE_DIR=${toolSource}")
ConfigureConsumer(PASS "" -DDESCRIPTION=ON)
file(READ "${PANGU_META_HOST_BUILD_ROOT}/BuildTools/PanguMetaTool/PanguMetaToolBuildInputs.cmake" inputs)
string(FIND "${inputs}" "/Source/ThirdParty/NlohmannJson/Repo/single_include/nlohmann/json.hpp" jsonInput)
if(jsonInput LESS 0)
    message(FATAL_ERROR "Native host manifest omits the actual NlohmannJson single_include header")
endif()
BuildConsumer(PASS "PanguMetaTool generate")
BuildConsumer(PASS "no work to do")
if(CMAKE_HOST_WIN32)
    set(suffix .exe)
endif()
file(TIMESTAMP "${binary}/Consumer${suffix}" consumerBefore "%s.%f")
SnapshotOutputs(before)
file(APPEND "${toolSource}/Private/Main.cpp" "\n// 原生构建依赖失效回归。\n")
BuildConsumer(PASS "PanguMetaTool native host build")
RequireText("${commandOutput}" "PanguMetaTool generate")
SnapshotOutputs(after)
file(TIMESTAMP "${binary}/Consumer${suffix}" consumerAfter "%s.%f")
if(NOT before STREQUAL after OR NOT consumerBefore STREQUAL consumerAfter)
    message(FATAL_ERROR "Host tool rebuild must not rewrite identical outputs or relink Consumer")
endif()
BuildConsumer(PASS "no work to do")
RejectText("${commandOutput}" "PanguMetaTool generate")
RejectText("${commandOutput}" "BuildMetaTool.cmake")
# 源集合缩减必须先刷新父图，不能让旧清单中的不存在文件阻断普通 build。
file(TIMESTAMP "${generated}/Meta.request.json" requestBefore "%s.%f")
file(TIMESTAMP "${generated}/Private/MetaContext.cpp" contextBefore "%s.%f")
file(RENAME "${toolSource}/Private/Main.cpp" "${toolSource}/Private/RenamedMain.cpp")
file(READ "${toolSource}/CMakeLists.txt" toolCmake)
string(REPLACE "Private/Main.cpp" "Private/RenamedMain.cpp" toolCmake "${toolCmake}")
file(WRITE "${toolSource}/CMakeLists.txt" "${toolCmake}")
BuildConsumer(PASS "PanguMetaTool native host build")
RejectText("${commandOutput}" "CMakeFiles/Owner.dir")
RejectText("${commandOutput}" "CMakeFiles/Consumer.dir")
SnapshotOutputs(after)
file(TIMESTAMP "${binary}/Consumer${suffix}" consumerAfter "%s.%f")
if(NOT before STREQUAL after OR NOT consumerBefore STREQUAL consumerAfter)
    message(FATAL_ERROR "Host source rename must not rewrite generated code or relink Consumer")
endif()
file(READ "${PANGU_META_HOST_BUILD_ROOT}/BuildTools/PanguMetaTool/PanguMetaToolBuildInputs.cmake" inputs)
RejectText("${inputs}" "${toolSource}/Private/Main.cpp")
RequireText("${inputs}" "${toolSource}/Private/RenamedMain.cpp")
file(READ "${binary}/build.ninja" rules)
string(FIND "${rules}" "/ToolSource/Private/Main.cpp" retiredInput)
if(NOT retiredInput LESS 0)
    message(FATAL_ERROR "Parent native graph retains the retired host source")
endif()
BuildConsumer(PASS "no work to do")
RejectText("${commandOutput}" "Re-running CMake")
RejectText("${commandOutput}" "PanguMetaTool")
# 不修改 CMakeLists，仅删除未使用的旧登记头，同样必须恢复并移除旧显式输入。
file(REMOVE "${toolSource}/Private/Unused.h")
BuildConsumer(PASS "")
RejectText("${commandOutput}" "CMakeFiles/Owner.dir")
RejectText("${commandOutput}" "CMakeFiles/Consumer.dir")
SnapshotOutputs(after)
file(TIMESTAMP "${binary}/Consumer${suffix}" consumerAfter "%s.%f")
if(NOT before STREQUAL after OR NOT consumerBefore STREQUAL consumerAfter)
    message(FATAL_ERROR "Removing an unused host header must preserve generated code and Consumer")
endif()
file(READ "${PANGU_META_HOST_BUILD_ROOT}/BuildTools/PanguMetaTool/PanguMetaToolBuildInputs.cmake" inputs)
RejectText("${inputs}" "${toolSource}/Private/Unused.h")
file(READ "${binary}/build.ninja" rules)
string(FIND "${rules}" "/ToolSource/Private/Unused.h" retiredInput)
if(NOT retiredInput LESS 0)
    message(FATAL_ERROR "Parent native graph retains the retired unused header")
endif()
file(TIMESTAMP "${generated}/Meta.request.json" requestAfter "%s.%f")
file(TIMESTAMP "${generated}/Private/MetaContext.cpp" contextAfter "%s.%f")
if(NOT requestBefore STREQUAL requestAfter OR NOT contextBefore STREQUAL contextAfter)
    message(FATAL_ERROR "Host input retirement rewrote an unchanged request or MetaContext")
endif()
BuildConsumer(PASS "no work to do")
RejectText("${commandOutput}" "Re-running CMake")
RejectText("${commandOutput}" "PanguMetaTool")
file(APPEND "${source}/Unrelated.cpp" "\nstatic_assert(1 == 1);\n")
BuildConsumer(PASS "Unrelated.cpp")
RejectText("${commandOutput}" "PanguMetaTool generate")
RejectText("${commandOutput}" "Main.cpp")
SnapshotOutputs(before)
file(APPEND "${source}/Public/Dependency.h" "\n// 传递依赖变化不改变元数据。\n")
BuildConsumer(PASS "PanguMetaTool generate")
SnapshotOutputs(after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "Identical generated content must retain hash and mtime")
endif()
file(TIMESTAMP "${binary}/Consumer${suffix}" consumerBefore "%s.%f")
ConfigureConsumer(PASS "" -DFIXTURE_VALUE=2)
BuildConsumer(PASS "PanguMetaTool generate")
SnapshotOutputs(after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "Flag changes must not rewrite identical generated files")
endif()
file(TIMESTAMP "${binary}/Consumer${suffix}" consumerAfter "%s.%f")
if(NOT consumerBefore STREQUAL consumerAfter)
    message(FATAL_ERROR "Owner-only flag changes must not relink the metadata consumer")
endif()
file(REMOVE "${generated}/Public/Actor.gen.h")
BuildConsumer(PASS "PanguMetaTool generate")
if(NOT EXISTS "${generated}/Public/Actor.gen.h")
    message(FATAL_ERROR "MissingByproductRecovers failed")
endif()
BuildConsumer(PASS "no work to do")
