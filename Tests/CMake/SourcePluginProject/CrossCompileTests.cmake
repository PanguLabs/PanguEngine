cmake_minimum_required(VERSION 4.0)
include("${CMAKE_CURRENT_LIST_DIR}/ProjectTestHelpers.cmake")
if(NOT PANGU_TARGET_PRESET MATCHES "^(android-arm64|ios-arm64)$")
    message(FATAL_ERROR "CrossCompileTests requires PANGU_TARGET_PRESET=android-arm64 or ios-arm64")
endif()
set(ENV{PANGU_ENGINE_SOURCE_DIR} "${PANGU_ENGINE_SOURCE_DIR}")
set(binary "${PANGU_TEST_ROOT}/CrossBuild")
ProjectCommand(PASS "" "${CMAKE_COMMAND}" --preset "${PANGU_TARGET_PRESET}"
    -S "${source}" -B "${binary}"
    "-DPANGU_ENGINE_SOURCE_DIR:PATH=${PANGU_ENGINE_SOURCE_DIR}"
    "-DPANGU_FIXTURE_ENGINE_ROOT:PATH=${PANGU_TEST_ROOT}/FixtureEngine"
    "-DPANGU_ENABLED_PLUGINS:STRING=pangu.physics;mygame.gameplay;mygame.editor-extras;mygame.assets-only;mygame.shared-probe"
    -DPANGU_FIXTURE_BUILD_HOSTS=ON -DPANGU_ENGINE_ALLOW_LOCAL_OVERRIDE=ON)
foreach(target IN ITEMS MyGame MyEditor MyGameDeployShared)
    BuildFixture("${target}")
endforeach()
ProjectCommand(PASS "" ninja -C "${binary}" -t commands MyGame)
file(WRITE "${PANGU_TEST_ROOT}/TargetCommands.txt" "${commandOutput}")
if(PANGU_TARGET_PRESET STREQUAL "android-arm64")
    RequireText("${commandOutput}" "aarch64")
    RequireText("${commandOutput}" "android")
else()
    RequireText("${commandOutput}" "-arch arm64")
    RequireText("${commandOutput}" "iPhoneOS")
endif()
if(CMAKE_HOST_WIN32)
    set(hostTool "${binary}/BuildTools/PanguBuildTool/PanguBuildTool.exe")
else()
    set(hostTool "${binary}/BuildTools/PanguBuildTool/PanguBuildTool")
endif()
ProjectCommand(PASS "" "${hostTool}" discover --engine-root "${PANGU_TEST_ROOT}/FixtureEngine")
string(JSON count LENGTH "${commandOutput}" plugins)
if(NOT count EQUAL 1)
    message(FATAL_ERROR "Cross build must execute the host tool and discover Physics")
endif()
message(STATUS "${PANGU_TARGET_PRESET}: independent Project Game/Editor link + SHARED deployment passed; no device execution")
