cmake_minimum_required(VERSION 4.0)
if(NOT DEFINED PANGU_SOURCE_ROOT OR NOT DEFINED PANGU_TEST_ROOT)
    message(FATAL_ERROR "EngineRevisionTests requires PANGU_SOURCE_ROOT and PANGU_TEST_ROOT")
endif()
set(checker "${PANGU_SOURCE_ROOT}/cmake/PanguEngineRevision.cmake")
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef runId)
set(PANGU_TEST_ROOT "${PANGU_TEST_ROOT}/${runId}")
set(mini "${PANGU_TEST_ROOT}/RevisionGit")
set(sub "${PANGU_TEST_ROOT}/RevisionSub")
file(MAKE_DIRECTORY "${mini}" "${sub}")
file(WRITE "${mini}/CMakeLists.txt" "cmake_minimum_required(VERSION 4.0)\n")
file(WRITE "${sub}/sub.txt" "sub content\n")

function(GitAt repo)
    execute_process(COMMAND git -C "${repo}" ${ARGN}
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err
        OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "Git failed in ${repo}: git ${ARGN}\n${err}\n${out}")
    endif()
    set(gitOut "${out}" PARENT_SCOPE)
endfunction()
foreach(repo IN ITEMS "${mini}" "${sub}")
    GitAt("${repo}" init -q)
    GitAt("${repo}" config user.name "Fixture User")
    GitAt("${repo}" config user.email "fixture@example.invalid")
endforeach()
GitAt("${sub}" add sub.txt)
GitAt("${sub}" commit -qm "one")
GitAt("${mini}" add CMakeLists.txt)
GitAt("${mini}" commit -qm "one")
GitAt("${mini}" rev-parse HEAD)
set(commit1 "${gitOut}")
file(APPEND "${mini}/CMakeLists.txt" "# two\n")
GitAt("${mini}" add CMakeLists.txt)
GitAt("${mini}" commit -qm "two")
GitAt("${mini}" rev-parse HEAD)
set(commit2 "${gitOut}")

set(caseScript "${PANGU_TEST_ROOT}/RevisionCase.cmake")
file(WRITE "${caseScript}" [=[
cmake_minimum_required(VERSION 4.0)
include("${PANGU_REVISION_MODULE}")
pangu_validate_engine_revision(
    SOURCE_DIR "${PANGU_REVISION_SOURCE}"
    EXPECTED_COMMIT "${PANGU_REVISION_EXPECTED}"
    ALLOW_LOCAL_OVERRIDE "${PANGU_REVISION_OVERRIDE}")
]=])
function(ExpectCheck expectedOk expectedText sha override)
    set(checkedSource "${mini}")
    if(ARGC GREATER 4)
        set(checkedSource "${ARGV4}")
    endif()
    execute_process(
        COMMAND "${CMAKE_COMMAND}" "-DPANGU_REVISION_MODULE=${checker}"
            "-DPANGU_REVISION_SOURCE=${checkedSource}"
            "-DPANGU_REVISION_EXPECTED=${sha}"
            "-DPANGU_REVISION_OVERRIDE=${override}" -P "${caseScript}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    set(diagnostics "${stdout}\n${stderr}")
    if(expectedOk)
        if(NOT rc EQUAL 0)
            message(FATAL_ERROR "Git revision was unexpectedly rejected: ${rc}\n${diagnostics}")
        endif()
    elseif(rc EQUAL 0)
        message(FATAL_ERROR "Git revision was unexpectedly accepted: ${expectedText}")
    endif()
    if(NOT expectedText STREQUAL "")
        string(FIND "${diagnostics}" "${expectedText}" found)
        if(found LESS 0)
            message(FATAL_ERROR "Missing diagnostic '${expectedText}':\n${diagnostics}")
        endif()
    endif()
endfunction()

ExpectCheck(TRUE "" "${commit2}" OFF)
file(MAKE_DIRECTORY "${mini}/UntrackedEngine")
file(WRITE "${mini}/UntrackedEngine/CMakeLists.txt" "# untracked nested Engine copy\n")
ExpectCheck(FALSE "worktree root" "${commit2}" OFF "${mini}/UntrackedEngine")
GitAt("${mini}" worktree add --detach -q "${PANGU_TEST_ROOT}/LinkedEngine" "${commit2}")
ExpectCheck(TRUE "" "${commit2}" OFF "${PANGU_TEST_ROOT}/LinkedEngine")
string(TOUPPER "${commit2}" upperCommit)
ExpectCheck(TRUE "" "${upperCommit}" OFF)
file(WRITE "${mini}/untracked.txt" "local build output\n")
ExpectCheck(TRUE "" "${commit2}" OFF)
ExpectCheck(FALSE "expected" "${commit1}" OFF)
ExpectCheck(FALSE "40" "invalid" OFF)
file(APPEND "${mini}/CMakeLists.txt" "# dirty\n")
ExpectCheck(FALSE "dirty" "${commit2}" OFF)
GitAt("${mini}" add CMakeLists.txt)
ExpectCheck(FALSE "dirty" "${commit2}" OFF)
GitAt("${mini}" restore --staged CMakeLists.txt)
ExpectCheck(TRUE "${commit1}" "${commit1}" ON)
ExpectCheck(TRUE "${commit2}" "${commit1}" ON)
GitAt("${mini}" restore CMakeLists.txt)
GitAt("${mini}" -c protocol.file.allow=always submodule add -q "${sub}" ExternalSub)
GitAt("${mini}" commit -am "add submodule" -q)
GitAt("${mini}" rev-parse HEAD)
set(commitWithSubmodule "${gitOut}")
ExpectCheck(TRUE "" "${commitWithSubmodule}" OFF)
file(APPEND "${sub}/sub.txt" "changed\n")
GitAt("${sub}" add sub.txt)
GitAt("${sub}" commit -qm "two")
GitAt("${sub}" rev-parse HEAD)
set(nextSubCommit "${gitOut}")
GitAt("${mini}/ExternalSub" fetch -q "${sub}" "${nextSubCommit}")
GitAt("${mini}/ExternalSub" checkout -q "${nextSubCommit}")
ExpectCheck(FALSE "submodule" "${commitWithSubmodule}" OFF)
GitAt("${mini}/ExternalSub" checkout -q HEAD~1)
ExpectCheck(TRUE "" "${commitWithSubmodule}" OFF)
GitAt("${mini}" -c protocol.file.allow=always submodule deinit -f ExternalSub)
ExpectCheck(FALSE "submodule" "${commitWithSubmodule}" OFF)
ExpectCheck(TRUE "dirty" "${commitWithSubmodule}" ON)
message(STATUS "Engine revision tests completed")
