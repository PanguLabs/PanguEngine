    -DPANGU_FIXTURE_BUILD_HOSTS=OFF "-DPANGU_FIXTURE_PROBE_DEPENDENCIES:STRING=Pangu::Gameplay")
BuildFixture(MyGameProbe)
ProjectCommand(PASS "" ninja -C "${binary}" -t targets all)
