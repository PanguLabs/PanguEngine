file(MAKE_DIRECTORY "${newPlugin}")
file(WRITE "${newPlugin}/Plugin.toml" "[plugin]\nid = 'INVALID'\n")
file(WRITE "${newPlugin}/CMakeLists.txt" "message(FATAL_ERROR \"not enabled\")\n")
BuildFixture(MyGame)
