{
  "version": 9,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/Build/Windows",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "$env{LLVM_ROOT}/bin/clang++.exe",
        "CMAKE_CXX_COMPILER_CLANG_SCAN_DEPS": "$env{LLVM_ROOT}/bin/clang-scan-deps.exe",
        "PANGU_ENGINE_SOURCE_DIR": "$env{PANGU_ENGINE_SOURCE_DIR}",
        "BUILD_TESTING": true
      }
    },
    {
      "name": "linux",
      "generator": "Ninja",
      "binaryDir": "$env{HOME}/PanguEngineBuild/Projects/MyGame/Linux",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "toolchainFile": "$env{PANGU_ENGINE_SOURCE_DIR}/cmake/Platform/Linux/Toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER_CLANG_SCAN_DEPS": "$env{LLVM_ROOT}/bin/clang-scan-deps",
        "PANGU_ENGINE_SOURCE_DIR": "$env{PANGU_ENGINE_SOURCE_DIR}",
        "BUILD_TESTING": true
      }
    },
    {
      "name": "macos",
      "generator": "Ninja",
      "binaryDir": "$env{HOME}/PanguEngineBuild/Projects/MyGame/macOS",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "toolchainFile": "$env{PANGU_ENGINE_SOURCE_DIR}/cmake/Platform/macOS/Toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER_CLANG_SCAN_DEPS": "$env{LLVM_ROOT}/bin/clang-scan-deps",
        "PANGU_ENGINE_SOURCE_DIR": "$env{PANGU_ENGINE_SOURCE_DIR}",
        "BUILD_TESTING": true
      }
    },
    {
      "name": "android-arm64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/Build/Android",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_ANDROID_NDK": "$env{ANDROID_NDK_HOME}",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-29",
        "ANDROID_STL": "c++_shared",
        "PANGU_ENGINE_SOURCE_DIR": "$env{PANGU_ENGINE_SOURCE_DIR}",
        "BUILD_TESTING": false
      }
    },
    {
      "name": "ios-arm64",
      "generator": "Ninja",
      "binaryDir": "$env{HOME}/PanguEngineBuild/Projects/MyGame/iOS",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "toolchainFile": "$env{PANGU_ENGINE_SOURCE_DIR}/cmake/Platform/iOS/Toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PANGU_ENGINE_SOURCE_DIR": "$env{PANGU_ENGINE_SOURCE_DIR}",
        "BUILD_TESTING": false
      }
    }
  ]
}
