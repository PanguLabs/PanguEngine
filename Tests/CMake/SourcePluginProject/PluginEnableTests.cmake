cmake_minimum_required(VERSION 4.0)
include("${CMAKE_CURRENT_LIST_DIR}/ProjectTestHelpers.cmake")

# 缺失启用接线、未启用 CMakeLists 被执行或 ALL 泄漏均须失败。
foreach(linkMode IN ITEMS Monolithic Modular)
    set(selection "Selection-${linkMode}")
    ConfigureFixture("${selection}" "pangu.physics;mygame.gameplay" PASS "" "-DPANGU_LINK_MODE=${linkMode}")
    file(READ "${binary}/PluginVisits.txt" visits)
    if(NOT visits STREQUAL "mygame.gameplay\npangu.physics\n")
        message(FATAL_ERROR "Only enabled plugins should execute, in ID order: ${visits}")
    endif()
    file(READ "${binary}/compile_commands.json" commands)
    RequireText("${commands}" "Gameplay.cpp")
    RequireText("${commands}" "Physics.cpp")
    RejectText("${commands}" "EditorExtras.cpp")
    BuildFixture(all)
    file(GLOB libraries "${binary}/EngineBuild/Lib/*Physics*" "${binary}/EngineBuild/Bin/*Physics*" "${binary}/Lib/*Gameplay*"
        "${binary}/Bin/*Physics*" "${binary}/Bin/*Gameplay*")
    if(libraries)
        message(FATAL_ERROR "Unconsumed enabled plugins leaked into ALL: ${libraries}")
    endif()
    file(APPEND "${source}/Plugins/EditorExtras/Private/EditorExtras.cpp" "\n// 未启用插件的增量输入\n")
    BuildFixture(all)
    RequireText("${commandOutput}" "no work to do")

    ConfigureFixture("${selection}" "pangu.physics;mygame.gameplay;mygame.editor-extras" PASS ""
        "-DPANGU_FIXTURE_PROBE_DEPENDENCIES:STRING=Pangu::Gameplay" "-DPANGU_LINK_MODE=${linkMode}")
    BuildFixture(MyGameProbe)
    file(GLOB physics "${binary}/EngineBuild/Lib/*Physics*" "${binary}/EngineBuild/Bin/*Physics*")
    file(GLOB gameplay "${binary}/Lib/*Gameplay*" "${binary}/Bin/*Gameplay*")
    file(GLOB editor "${binary}/Lib/*EditorExtras*" "${binary}/Bin/*EditorExtras*")
    if(NOT physics OR NOT gameplay OR editor)
        message(FATAL_ERROR "Probe must build only its transitive plugin libraries")
    endif()
    ProjectCommand(PASS "" ninja -C "${binary}" -t commands MyGameProbe)
    RequireText("${commandOutput}" "Gameplay.cpp")
    RequireText("${commandOutput}" "Physics.cpp")
    RejectText("${commandOutput}" "EditorExtras.cpp")
    ProjectCommand(PASS "" ninja -C "${binary}" -t targets all)
    RequireText("${commandOutput}" "PanguEditorExtras")
    BuildFixture(PanguEditorExtras)
    file(GLOB editor "${binary}/Lib/*EditorExtras*" "${binary}/Bin/*EditorExtras*")
    if(NOT editor)
        message(FATAL_ERROR "Explicit plugin target did not build")
    endif()
endforeach()

ConfigureFixture(Selection "missing.plugin" FAIL "missing.plugin")
ConfigureFixture(Selection "pangu.physics;pangu.physics" FAIL "Duplicate enabled")
ConfigureFixture(Selection "Pangu.Physics" FAIL "Pangu.Physics")
ConfigureFixture(Selection "mygame.gameplay" FAIL "Pangu::Physics")
file(APPEND "${source}/Plugins/EditorExtras/CMakeLists.txt" "\nadd_library(PanguPhysics STATIC Private/EditorExtras.cpp)\n")
ConfigureFixture(Selection "pangu.physics;mygame.editor-extras" FAIL "PanguPhysics")
message(STATUS "Plugin selection, late target dependencies and consumer-only builds passed")
