function(CheckOwnership engineExpected projectExpected collaborationExpected probeExpected)
    ProjectCommand(PASS "" "${CMAKE_CTEST_COMMAND}" --test-dir "${binary}" --show-only=json-v1)
    set(json "${commandStdout}")
    foreach(entry IN ITEMS
            "PanguPhysicsPluginTests.PhysicsPlugin.DefinitionMatchesModule|${engineExpected}|engine|pangu.physics|unit"
            "MyGameGameplayPluginTests.GameplayPlugin.DependsOnPhysics|${projectExpected}|project|mygame.gameplay|unit"
            "MyGamePluginCollaborationTests.ProjectPluginCollaboration.RegistersProviderFirst|${collaborationExpected}|project||integration"
            "MyGameProbe|${probeExpected}|project||integration")
        string(REPLACE "|" ";" fields "${entry}")
        list(GET fields 0 wanted)
        list(GET fields 1 expected)
        list(GET fields 2 owner)
        list(GET fields 3 plugin)
        list(GET fields 4 boundary)
        if(NOT expected)
            string(REGEX REPLACE "[.].*$" "" disabledTarget "${wanted}")
            RejectText("${json}" "${disabledTarget}")
        endif()
        set(found OFF)
        string(JSON count LENGTH "${json}" tests)
        if(count GREATER 0)
            math(EXPR last "${count} - 1")
            foreach(index RANGE 0 ${last})
                string(JSON name GET "${json}" tests ${index} name)
                if(NOT name STREQUAL wanted)
                    continue()
                endif()
                set(found ON)
                string(JSON properties GET "${json}" tests ${index} properties)
                RequireText("${properties}" "owner.${owner}")
                RequireText("${properties}" "boundary.${boundary}")
                RequireText("${properties}" "area.build")
                RequireText("${properties}" "run.full")
                if(plugin)
                    RequireText("${properties}" "plugin.${plugin}")
                else()
                    RejectText("${properties}" "plugin.")
                endif()
                if(NOT wanted STREQUAL "MyGameProbe")
                    RequireText("${properties}" "run.fast")
                else()
                    RequireText("${properties}" "run.precommit")
                    RejectText("${properties}" "run.fast")
                endif()
            endforeach()
        endif()
        if(expected AND NOT found)
            message(FATAL_ERROR "Missing owned test ${wanted}: ${json}")
        elseif(NOT expected AND found)
            message(FATAL_ERROR "Disabled owner/Plugin registered ${wanted}")
        endif()
    endforeach()
endfunction()

