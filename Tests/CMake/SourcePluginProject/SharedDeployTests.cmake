cmake_minimum_required(VERSION 4.0)
include("${CMAKE_CURRENT_LIST_DIR}/ProjectTestHelpers.cmake")
ConfigureFixture(Shared "pangu.physics;mygame.gameplay;mygame.editor-extras;mygame.shared-probe" PASS ""
    -DPANGU_FIXTURE_BUILD_HOSTS=ON -DPANGU_LINK_MODE=Modular)
BuildFixture(MyGame)
file(GLOB shared "${binary}/Bin/*SharedProbe*")
file(GLOB deployed "${binary}/Deploy/*SharedProbe*")
if(shared OR deployed)
    message(FATAL_ERROR "Game built/deployed an unconsumed SHARED Module")
endif()
CheckConsumer(MyGame Modular Gameplay EditorExtras)
file(STRINGS "${binary}/MyGameDeployManifest.txt" gamePaths)
list(GET gamePaths 1 gameplayDeploy)
file(RENAME "${gameplayDeploy}" "${gameplayDeploy}.missing")
if(CMAKE_HOST_WIN32)
    set(executableSuffix .exe)
endif()
# DLL 缺失必须使 Manager Load 失败，证明激活来自明确部署候选。
ProjectCommand(FAIL "Manager candidate load failed" "${binary}/Bin/MyGame${executableSuffix}")
file(RENAME "${gameplayDeploy}.missing" "${gameplayDeploy}")
CheckConsumer(MyGame Modular Gameplay EditorExtras)
BuildFixture(MyGameDeployShared)
file(STRINGS "${binary}/SharedDeployManifest.txt" paths)
list(GET paths 0 library)
list(GET paths 1 deployed)
foreach(path IN ITEMS "${library}" "${deployed}")
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "SHARED output/deployment missing: ${path}")
    endif()
    file(SIZE "${path}" size)
    if(size EQUAL 0)
        message(FATAL_ERROR "SHARED output/deployment is empty: ${path}")
    endif()
endforeach()
file(SHA256 "${library}" originalHash)
file(SHA256 "${deployed}" deployedHash)
if(NOT originalHash STREQUAL deployedHash)
    message(FATAL_ERROR "Deployment differs from TARGET_FILE")
endif()
file(READ "${deployed}" magic OFFSET 0 LIMIT 4 HEX)
if(CMAKE_HOST_WIN32)
    if(NOT magic MATCHES "^4d5a")
        message(FATAL_ERROR "Expected PE DLL: ${magic}")
    endif()
elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    if(NOT magic STREQUAL "7f454c46")
        message(FATAL_ERROR "Expected ELF library: ${magic}")
    endif()
elseif(NOT magic MATCHES "^(cffaedfe|feedfacf)")
    message(FATAL_ERROR "Expected Mach-O library: ${magic}")
endif()
get_filename_component(name "${deployed}" NAME)
if(name MATCHES "Windows|Linux|macOS|Android|iOS")
    message(FATAL_ERROR "Artifact name contains a platform: ${name}")
endif()
file(TIMESTAMP "${deployed}" before "%s")
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1)
BuildFixture(MyGameDeployShared)
RequireText("${commandOutput}" "no work to do")
file(TIMESTAMP "${deployed}" after "%s")
if(NOT before STREQUAL after)
    message(FATAL_ERROR "Unchanged SHARED deployment was rewritten")
endif()
message(STATUS "Explicit SHARED deployment, Manager registration/activation/shutdown and unchanged-deploy noop passed")
