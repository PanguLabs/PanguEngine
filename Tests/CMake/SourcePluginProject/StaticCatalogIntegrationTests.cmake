cmake_minimum_required(VERSION 4.0)
include("${CMAKE_CURRENT_LIST_DIR}/ProjectTestHelpers.cmake")

set(enabled "pangu.physics;mygame.gameplay;mygame.editor-extras")
foreach(host IN ITEMS MyGame MyEditor)
    ConfigureFixture("${host}" "${enabled}" PASS "" -DPANGU_FIXTURE_BUILD_HOSTS=ON)
    BuildFixture("${host}")
    if(host STREQUAL "MyGame")
        set(unused EditorExtras)
    else()
        set(unused Gameplay)
    endif()
    file(GLOB unusedFiles "${binary}/Lib/*${unused}*")
    if(unusedFiles)
        message(FATAL_ERROR "${host} built unrelated ${unused}: ${unusedFiles}")
    endif()
    ProjectCommand(PASS "" ninja -C "${binary}" -t commands "${host}")
    RejectText("${commandOutput}" "${unused}.cpp")
    RequireText("${commandOutput}" "Physics.cpp")
    if(CMAKE_HOST_WIN32)
        set(suffix .exe)
    else()
        set(suffix "")
    endif()
    ProjectCommand(PASS "" "${binary}/${host}${suffix}")
endforeach()

ConfigureFixture(Assets "pangu.physics;mygame.gameplay;mygame.assets-only" PASS ""
    -DPANGU_FIXTURE_BUILD_HOSTS=OFF)
BuildFixture(all)
file(GLOB pluginLibraries "${binary}/Lib/*Physics*" "${binary}/Lib/*Gameplay*" "${binary}/Lib/*Assets*")
if(pluginLibraries)
    message(FATAL_ERROR "Assets/enabled-only plugins must not build without consumers")
endif()
ProjectCommand(PASS "" ninja -C "${binary}" -t targets all)
RejectText("${commandOutput}" "PanguEditorExtras")
RejectText("${commandOutput}" "PanguAssets")
file(REMOVE "${source}/Plugins/AssetsOnly/Plugin.toml")
ProjectCommand(FAIL "both Plugin.toml and CMakeLists.txt" "${CMAKE_COMMAND}" --build "${binary}")
message(STATUS "Independent Game/Editor catalogs, registration order and assets-only plugins passed")
