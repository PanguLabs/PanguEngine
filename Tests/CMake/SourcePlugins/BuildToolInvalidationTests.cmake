function(FileLink target path)
    set(nativeTarget "${target}")
    if(CMAKE_HOST_WIN32)
        # 相对目标直接写入 reparse 数据，必须使用 Windows 原生分隔符。
        string(REPLACE "/" "\\" nativeTarget "${target}")
    endif()
    file(CREATE_LINK "${nativeTarget}" "${path}" SYMBOLIC RESULT result)
    if(ARGC GREATER 2)
        set("${ARGV2}" "${result}" PARENT_SCOPE)
    elseif(NOT result STREQUAL "0")
        message(FATAL_ERROR "Cannot create file symlink: ${result}")
    endif()
endfunction()

function(RunConfigure)
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${source}" -B "${binary}" -G Ninja
        RESULT_VARIABLE rc OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "Explicit configure should succeed: ${rc}\n${stdout}\n${stderr}")
    endif()
endfunction()

function(RunBuild shouldPass diagnostic)
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${binary}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(shouldPass)
        if(NOT rc EQUAL 0)
            message(FATAL_ERROR "Incremental build should succeed: ${rc}\n${stdout}\n${stderr}")
        endif()
        if(NOT diagnostic STREQUAL "" AND NOT stdout MATCHES "${diagnostic}")
            message(FATAL_ERROR "Expected '${diagnostic}': ${stdout}\n${stderr}")
        endif()
    else()
        string(FIND "${stdout}\n${stderr}" "${diagnostic}" matchIndex)
        if(rc EQUAL 0 OR matchIndex EQUAL -1)
            message(FATAL_ERROR "Expected configure error '${diagnostic}', got: ${rc}\n${stdout}\n${stderr}")
        endif()
    endif()
endfunction()

