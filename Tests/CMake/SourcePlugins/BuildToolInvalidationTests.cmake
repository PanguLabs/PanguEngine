    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1)
    file(REMOVE "${plugin}/Plugin.toml")
    FileLink("${plugin}/Alternative.toml" "${plugin}/Plugin.toml")
    RunBuild(FALSE "[plugin].id")

    # 中间链接的改指只更新子目录项；两个目标均早于 Configure 创建。
    file(MAKE_DIRECTORY "${plugin}/Links")
    file(REMOVE "${plugin}/Plugin.toml")
    FileLink("../Metadata.toml" "${plugin}/Links/Current.toml")
    FileLink("Links/Current.toml" "${plugin}/Plugin.toml")
    RunConfigure()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1)
    file(REMOVE "${plugin}/Links/Current.toml")
    FileLink("../Alternative.toml" "${plugin}/Links/Current.toml")
    RunBuild(FALSE "[plugin].id")
    file(REMOVE "${plugin}/Links/Current.toml")
    FileLink("../Metadata.toml" "${plugin}/Links/Current.toml")
    RunBuild(TRUE "Re-running CMake")
    RunBuild(TRUE "no work to do")
    file(APPEND "${plugin}/Private/Unused.cpp" "\n// 私有源码变化不应扩大为 Configure 失效\n")
    RunBuild(TRUE "no work to do")

    file(REMOVE "${plugin}/Links/Current.toml")
    RunBuild(FALSE "both Plugin.toml and CMakeLists.txt")
    FileLink("../Metadata.toml" "${plugin}/Links/Current.toml")
    RunBuild(TRUE "Re-running CMake")

    # 未启用插件的 CMakeLists 链路也必须验证目标边界。
    file(WRITE "${plugin}/Metadata.cmake" "# valid disabled CMake input\n")
    file(WRITE "${source}/Engine/Outside.cmake" "# target outside the plugin directory\n")
    file(REMOVE "${plugin}/CMakeLists.txt")
    FileLink("../Metadata.cmake" "${plugin}/Links/Current.cmake")
    FileLink("Links/Current.cmake" "${plugin}/CMakeLists.txt")
    RunConfigure()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1)
    file(REMOVE "${plugin}/Links/Current.cmake")
    FileLink("../../../Outside.cmake" "${plugin}/Links/Current.cmake")
    RunBuild(FALSE "escapes source directory")
    file(REMOVE "${plugin}/Links/Current.cmake")
    FileLink("../Metadata.cmake" "${plugin}/Links/Current.cmake")
    RunBuild(TRUE "Re-running CMake")
    RunBuild(TRUE "no work to do")
elseif(CMAKE_HOST_WIN32)
