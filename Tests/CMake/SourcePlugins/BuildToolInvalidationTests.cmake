# 目录链接在 Windows 使用无需额外权限的 Junction；覆盖根入口的多级改指。
function(DirectoryLink action path target)
    if(CMAKE_HOST_WIN32)
        string(REPLACE "'" "''" quotedPath "${path}")
        string(REPLACE "'" "''" quotedTarget "${target}")
        if(action STREQUAL "CREATE")
            set(script "New-Item -ItemType Junction -Path '${quotedPath}' -Target '${quotedTarget}' -ErrorAction Stop | Out-Null")
        else()
            set(script "[System.IO.Directory]::Delete('${quotedPath}')")
        endif()
        execute_process(COMMAND powershell.exe -NoProfile -NonInteractive -Command "${script}"
            RESULT_VARIABLE linkResult OUTPUT_VARIABLE linkOutput ERROR_VARIABLE linkError)
        if(NOT linkResult EQUAL 0)
            message(FATAL_ERROR "Junction ${action} failed: ${linkOutput}\n${linkError}")
        endif()
    elseif(action STREQUAL "CREATE")
        file(CREATE_LINK "${target}" "${path}" SYMBOLIC)
    else()
        file(REMOVE "${path}")
    endif()
endfunction()

