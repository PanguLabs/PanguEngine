cmake_minimum_required(VERSION 4.0)

file(MAKE_DIRECTORY "${MARKER_ROOT}")
set(modes clean busy operating)
if(MODULAR)
    list(APPEND modes once)
endif()
foreach(mode IN LISTS modes)
    set(marker "${MARKER_ROOT}/${mode}.txt")
    file(REMOVE "${marker}")
    execute_process(COMMAND "${FIXTURE}" "${mode}" "${marker}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
    if(mode STREQUAL "clean")
        set(expected 0)
        if(MODULAR)
            set(unloads 2)
        else()
            set(unloads 0)
        endif()
        set(destroys 2)
    else()
        set(expected 91)
        set(unloads 0)
        if(mode STREQUAL "operating")
            set(destroys 0)
        else()
            set(destroys 1)
        endif()
    endif()
    if(NOT "${result}" STREQUAL "${expected}")
        message(FATAL_ERROR "${mode}: expected exit ${expected}, got ${result}; ${output}${error}")
    endif()
    if(NOT EXISTS "${marker}")
        message(FATAL_ERROR "${mode}: marker missing")
    endif()
    file(READ "${marker}" evidence)
    if(NOT evidence STREQUAL "NativeUnloadCount=${unloads}\nDestroyCount=${destroys}\n")
        message(FATAL_ERROR "${mode}: unexpected marker: ${evidence}")
    endif()
    message(STATUS "${mode}: exit=${result}; ${evidence}")
endforeach()
