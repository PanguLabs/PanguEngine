cmake_minimum_required(VERSION 4.0)

file(MAKE_DIRECTORY "${MARKER_ROOT}")
set(modes clean log-clean busy operating log-busy control-exit42 control-crash control-hang control-unprepared)
if(MODULAR)
    list(APPEND modes once)
endif()
foreach(mode IN LISTS modes)
    set(marker "${MARKER_ROOT}/${mode}.txt")
    file(REMOVE "${marker}")
    execute_process(COMMAND "${FIXTURE}" "${mode}" "${marker}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 3)
    if(CMAKE_HOST_WIN32)
        set(fatalResult "Exit code 0xc0000409")
    else()
        set(fatalResult "Subprocess killed")
    endif()
    if(mode MATCHES "^control-")
        if(result STREQUAL fatalResult)
            message(FATAL_ERROR "${mode}: 被误判为 Fatal=${result}")
        elseif(mode STREQUAL "control-unprepared")
            if(NOT result STREQUAL "90" OR EXISTS "${marker}")
                message(FATAL_ERROR "准备失败负对照不正确=${result}")
            endif()
            continue()
        elseif(mode STREQUAL "control-exit42" AND NOT result STREQUAL "42")
            message(FATAL_ERROR "${mode}: 错误退出未发生=${result}")
        elseif(mode STREQUAL "control-crash" AND (result MATCHES "^-?[0-9]+$" OR result MATCHES "timeout"))
            message(FATAL_ERROR "${mode}: 崩溃未发生=${result}")
        elseif(mode STREQUAL "control-hang" AND NOT result MATCHES "timeout")
            message(FATAL_ERROR "${mode}: 监督超时未发生=${result}")
        endif()
        file(READ "${marker}" evidence)
        if(NOT evidence STREQUAL "NativeUnloadCount=0\nDestroyCount=0\nFATAL_READY\n")
            message(FATAL_ERROR "${mode}: 负对照未准备=${evidence}")
        endif()
        message(STATUS "${mode}: exit=${result}; accepted=FALSE")
        continue()
    endif()
    if(mode STREQUAL "clean" OR mode STREQUAL "log-clean")
        set(expected 0)
        if(MODULAR AND mode STREQUAL "clean")
            set(unloads 2)
        else()
            set(unloads 0)
        endif()
        if(mode STREQUAL "clean")
            set(destroys 2)
        else()
            set(destroys 0)
        endif()
    else()
        set(expected "${fatalResult}")
        set(unloads 0)
        if(mode STREQUAL "operating" OR mode STREQUAL "log-busy")
            set(destroys 0)
        else()
            set(destroys 1)
        endif()
    endif()
    if(NOT "${result}" STREQUAL "${expected}")
        message(FATAL_ERROR "${mode}: expected exit ${expected}, got ${result}; ${output}${error}")
    endif()
    if(NOT EXISTS "${marker}")
        message(FATAL_ERROR "${mode}: marker missing")
    endif()
    file(READ "${marker}" evidence)
    if(NOT evidence STREQUAL "NativeUnloadCount=${unloads}\nDestroyCount=${destroys}\nFATAL_READY\n")
        message(FATAL_ERROR "${mode}: unexpected marker: ${evidence}")
    endif()
    message(STATUS "${mode}: exit=${result}; ${evidence}")
endforeach()
