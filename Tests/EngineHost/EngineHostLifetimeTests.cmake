cmake_minimum_required(VERSION 4.0)
file(MAKE_DIRECTORY "${MARKER_ROOT}")
set(marker "${MARKER_ROOT}/queried-access.txt")
file(REMOVE "${marker}")
execute_process(COMMAND "${FIXTURE}" "${marker}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "QueriedAccessSurvivesPhysicalUnload: exit=${result}; ${output}${error}")
endif()
if(NOT EXISTS "${marker}")
    message(FATAL_ERROR "QueriedAccessSurvivesPhysicalUnload: marker missing")
endif()
file(READ "${marker}" evidence)
if(NOT evidence STREQUAL "NativeUnload\nTokensReleased\n")
    message(FATAL_ERROR "QueriedAccessSurvivesPhysicalUnload: unexpected ordering: ${evidence}")
endif()
message(STATUS "EngineHostLifetime.QueriedAccessSurvivesPhysicalUnload: ${evidence}")
