cmake_minimum_required(VERSION 4.0)
set(probes throwing-new nothrow-new aligned-new)
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    list(APPEND probes malloc)
endif()
foreach(probe IN LISTS probes)
    execute_process(COMMAND "${FIXTURE}" "${probe}" RESULT_VARIABLE result)
    if(NOT result STREQUAL "91")
        message(FATAL_ERROR "分配探针 ${probe} 自验证失败：exit=${result}")
    endif()
endforeach()
execute_process(COMMAND "${FIXTURE}" initialize RESULT_VARIABLE initialized OUTPUT_VARIABLE init_output)
if(NOT initialized STREQUAL "0" OR NOT init_output MATCHES "InitializationAllocationRequests=0")
    message(FATAL_ERROR "真实初始化隐式分配关卡失败：exit=${initialized}; ${init_output}")
endif()
message(STATUS "${init_output}")
if(DEFINED EXPECT_ITERATOR_DEBUG_LEVEL AND
    NOT init_output MATCHES "IteratorDebugLevel=${EXPECT_ITERATOR_DEBUG_LEVEL}")
    message(FATAL_ERROR "正式分配门未消费所需 STL Debug ABI：${init_output}")
endif()
execute_process(COMMAND "${FIXTURE}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result STREQUAL "0" OR NOT output MATCHES "AllocationRequests=0 ConsoleWrites=1")
    message(FATAL_ERROR "无分配后端失败：exit=${result}; ${output}; ${error}")
endif()
if(CMAKE_HOST_WIN32 AND init_output MATCHES "IteratorDebugLevel=2" AND
    NOT output MATCHES "DebugInitializationOomCases=2 ProbeRejected=1 InitializationRejected=2")
    message(FATAL_ERROR "Debug 真实初始化 OOM 未执行：${output}")
endif()
message(STATUS "${output}")
