cmake_minimum_required(VERSION 4.0)
file(MAKE_DIRECTORY "${PANGU_TEST_ROOT}")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef _run)
foreach(_mode IN ITEMS public private busy)
    set(_marker "${PANGU_TEST_ROOT}/${_mode}-${_run}")
    execute_process(COMMAND "${PANGU_MODULE_LIFETIME_TEST}" "${_mode}" "${_marker}"
        RESULT_VARIABLE _result OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 15)
    if(_mode STREQUAL "busy")
        if(CMAKE_HOST_WIN32)
            set(_expected "Exit code 0xc0000409")
        else()
            set(_expected "Subprocess killed")
        endif()
        if(NOT "${_result}" STREQUAL "${_expected}" OR NOT EXISTS "${_marker}.ready" OR EXISTS "${_marker}.unloaded"
            OR NOT EXISTS "${_marker}.before-destruction")
            message(FATAL_ERROR "未完成的 Manager 析构必须终止且不得提前 NativeUnload: ${_result}\n${_stdout}\n${_stderr}")
        endif()
        file(READ "${_marker}.before-destruction" _unloads_before_termination)
        if(NOT "${_unloads_before_termination}" STREQUAL "0")
            message(FATAL_ERROR "进入析构前不应发生 NativeUnload: ${_unloads_before_termination}")
        endif()
    elseif(NOT "${_result}" STREQUAL "0" OR NOT EXISTS "${_marker}.unloaded" OR NOT EXISTS "${_marker}.released")
        message(FATAL_ERROR "${_mode} 访问凭据必须在真实 NativeUnload 后继续安全借用/复制/最终释放: ${_result}\n${_stdout}\n${_stderr}")
    endif()
endforeach()
