cmake_minimum_required(VERSION 4.0)

# Private CMake-to-host-tool evidence transport. It is not a loader manifest.
function(abi_fail text)
    set(cleanup_errors "")
    if(DEFINED output)
        foreach(name IN ITEMS profile.json canonical.json fingerprint.sha256 evidence.json compiler-evidence.json)
            file(REMOVE "${output}/${name}")
            if(EXISTS "${output}/${name}")
                string(APPEND cleanup_errors "\ncleanup_incomplete: ${output}/${name}")
            endif()
        endforeach()
    endif()
    message(FATAL_ERROR "Windows ABI collection: ${text}${cleanup_errors}")
endfunction()

function(abi_quote out value)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(REPLACE "\t" "\\t" value "${value}")
    set(${out} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(abi_path out path directory)
    string(REPLACE "\\" "/" path "${path}")
    cmake_path(ABSOLUTE_PATH path BASE_DIRECTORY "${directory}" NORMALIZE OUTPUT_VARIABLE normalized)
    string(REPLACE "\\" "/" normalized "${normalized}")
    string(TOLOWER "${normalized}" normalized)
    set(${out} "${normalized}" PARENT_SCOPE)
endfunction()

function(abi_run out err directory)
    execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${directory}"
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT result STREQUAL "0")
        abi_fail("Command failed (${result}): ${ARGN}\n${stderr}\n${stdout}")
    endif()
    set(${out} "${stdout}" PARENT_SCOPE)
    set(${err} "${stderr}" PARENT_SCOPE)
endfunction()

# Clang's native Windows driver uses Windows response-file quoting. All response
# paths are relative to the original command's working directory, including nested ones.
function(abi_expand out directory depth)
    if(depth GREATER 8)
        abi_fail("Response-file nesting exceeds eight levels.")
    endif()
    set(expanded "")
    foreach(arg IN LISTS ARGN)
        if(arg MATCHES "^@(.+)$")
            set(response "${CMAKE_MATCH_1}")
            cmake_path(ABSOLUTE_PATH response BASE_DIRECTORY "${directory}" NORMALIZE)
            if(NOT EXISTS "${response}" OR IS_DIRECTORY "${response}")
                abi_fail("Missing response file: ${response}")
            endif()
            file(SIZE "${response}" size)
            get_property(total GLOBAL PROPERTY PANGU_ABI_RESPONSE_BYTES)
            math(EXPR total "${total} + ${size}")
            if(total GREATER 1048576)
                abi_fail("Response-file input exceeds one MiB.")
            endif()
            set_property(GLOBAL PROPERTY PANGU_ABI_RESPONSE_BYTES "${total}")
            file(READ "${response}" contents)
            separate_arguments(tokens WINDOWS_COMMAND "${contents}")
            math(EXPR nested "${depth} + 1")
            abi_expand(tokens "${directory}" ${nested} ${tokens})
            list(APPEND expanded ${tokens})
        else()
            list(APPEND expanded "${arg}")
        endif()
    endforeach()
    set(${out} "${expanded}" PARENT_SCOPE)
endfunction()

if(NOT WIN32 OR NOT DEFINED PANGU_ABI_REQUEST OR NOT EXISTS "${PANGU_ABI_REQUEST}")
    abi_fail("A native Windows request file is required.")
endif()
file(READ "${PANGU_ABI_REQUEST}" request)
foreach(key IN ITEMS target compiler tool schema_file database objects_file output_directory probe)
    string(JSON value ERROR_VARIABLE error GET "${request}" "${key}")
    if(NOT error STREQUAL "NOTFOUND" OR value STREQUAL "")
        abi_fail("Missing request field: ${key}")
    endif()
    set(${key} "${value}")
endforeach()
set(output "${output_directory}")
set(PANGU_ABI_OUTPUT "${output}")
include("${CMAKE_CURRENT_LIST_DIR}/Prepare.cmake")
file(MAKE_DIRECTORY "${output}/work")
foreach(path IN ITEMS "${compiler}" "${tool}" "${schema_file}" "${database}" "${objects_file}" "${probe}")
    if(NOT EXISTS "${path}")
        abi_fail("Missing input: ${path}")
    endif()
endforeach()
get_filename_component(compiler_directory "${compiler}" DIRECTORY)
set(readobj "${compiler_directory}/llvm-readobj.exe")
if(NOT EXISTS "${readobj}" OR NOT EXISTS "${compiler_directory}/lld-link.exe")
    abi_fail("The selected LLVM installation must supply llvm-readobj and lld-link.")
endif()
abi_run(banner ignored "${output}" "${compiler}" --version)
abi_run(resource ignored "${output}" "${compiler}" --print-resource-dir)
string(STRIP "${resource}" resource)
abi_path(resource "${resource}" "${output}")
file(READ "${database}" database_text)
string(JSON count ERROR_VARIABLE error LENGTH "${database_text}")
if(NOT error STREQUAL "NOTFOUND" OR count LESS 1)
    abi_fail("Invalid or empty compile database.")
endif()
file(STRINGS "${objects_file}" object_paths ENCODING UTF-8)
list(FILTER object_paths EXCLUDE REGEX "^$")
if(NOT object_paths)
    abi_fail("Target has no compiled objects: ${target}")
endif()
set(units "[]")
set(all_objects "")
set(seen_objects "")
set(index 0)
math(EXPR last "${count} - 1")
foreach(object IN LISTS object_paths)
    abi_path(object "${object}" "${output}")
    if(object IN_LIST seen_objects OR NOT EXISTS "${object}")
        abi_fail("Duplicate or missing target object: ${object}")
    endif()
    list(APPEND seen_objects "${object}")
    set(matches 0)
    foreach(row RANGE 0 ${last})
        string(JSON directory ERROR_VARIABLE error GET "${database_text}" ${row} directory)
        if(NOT error STREQUAL "NOTFOUND")
            abi_fail("Compile entry has no working directory.")
        endif()
        string(JSON candidate ERROR_VARIABLE error GET "${database_text}" ${row} output)
        if(NOT error STREQUAL "NOTFOUND")
            abi_fail("Compile entry has no object output.")
        endif()
        abi_path(candidate "${candidate}" "${directory}")
        if(candidate STREQUAL object)
            math(EXPR matches "${matches} + 1")
            set(selected ${row})
            set(working "${directory}")
        endif()
    endforeach()
    if(NOT matches EQUAL 1)
        abi_fail("Expected exactly one compile entry for ${object}, found ${matches}.")
    endif()
    string(JSON source GET "${database_text}" ${selected} file)
    abi_path(source "${source}" "${working}")
    if(NOT source MATCHES "[.](cpp|cc|cxx)$")
        abi_fail("Only C++ translation units are supported: ${source}")
    endif()
    string(JSON command ERROR_VARIABLE error GET "${database_text}" ${selected} command)
    if(error STREQUAL "NOTFOUND")
        separate_arguments(arguments WINDOWS_COMMAND "${command}")
    else()
        string(JSON argument_count ERROR_VARIABLE error LENGTH "${database_text}" ${selected} arguments)
        if(NOT error STREQUAL "NOTFOUND" OR argument_count LESS 1)
            abi_fail("Compile entry has neither command nor arguments.")
        endif()
        set(arguments "")
        math(EXPR argument_last "${argument_count} - 1")
        foreach(argument_index RANGE 0 ${argument_last})
            string(JSON argument GET "${database_text}" ${selected} arguments ${argument_index})
            list(APPEND arguments "${argument}")
        endforeach()
    endif()
    set_property(GLOBAL PROPERTY PANGU_ABI_RESPONSE_BYTES 0)
    abi_expand(arguments "${working}" 0 ${arguments})
    list(POP_FRONT arguments executable)
    abi_path(executable "${executable}" "${working}")
    abi_path(expected_compiler "${compiler}" "${working}")
    if(NOT executable STREQUAL expected_compiler)
        abi_fail("Compile entry does not use the selected Clang: ${executable}")
    endif()
    set(flags "")
    set(skip FALSE)
    set(source_count 0)
    foreach(arg IN LISTS arguments)
        if(skip)
            set(skip FALSE)
            continue()
        endif()
        if(arg STREQUAL "-o" OR arg STREQUAL "-MF" OR arg STREQUAL "-MT" OR arg STREQUAL "-MQ" OR arg STREQUAL "-MJ")
            set(skip TRUE)
        elseif(arg STREQUAL "-c" OR arg STREQUAL "-MD" OR arg STREQUAL "-MMD" OR arg STREQUAL "-MP")
            continue()
        elseif(arg MATCHES "^(-o|-MF|-MT|-MQ|-MJ).+")
            continue()
        else()
            abi_path(possible_source "${arg}" "${working}")
            if(possible_source STREQUAL source)
                math(EXPR source_count "${source_count} + 1")
            else()
                list(APPEND flags "${arg}")
            endif()
        endif()
    endforeach()
    if(skip OR NOT source_count EQUAL 1)
        abi_fail("Malformed compile entry for ${source}")
    endif()
    set(wrapper "${output}/work/unit-${index}.cpp")
    file(WRITE "${wrapper}" "#include \"${source}\"\n#include \"${probe}\"\n")
    abi_run(macros headers "${working}" "${compiler}" ${flags} -Werror=unknown-warning-option -E -dM -H "${wrapper}")
    abi_run(ignored driver "${working}" "${compiler}" ${flags} "-###" -fsyntax-only "${wrapper}")
    abi_run(ignored syntax_errors "${working}" "${compiler}" ${flags} -Werror=unknown-warning-option -fsyntax-only "${wrapper}")
    abi_run(directives ignored "${working}" "${readobj}" --coff-directives "${object}")
    string(REGEX MATCH "\"-triple\" \"([^\"]+)\"" triple_match "${driver}")
    if(NOT triple_match)
        abi_fail("Cannot determine actual frontend target triple.")
    endif()
    set(unit_triple "${CMAKE_MATCH_1}")
    # Header provenance must agree for every TU, even when version macros match.
    string(REPLACE "\r" "" header_lines "${headers}")
    string(REPLACE "\n" ";" header_lines "${header_lines}")
    unset(unit_stl)
    unset(unit_corecrt)
    unset(unit_sdkddkver)
    foreach(line IN LISTS header_lines)
        if(line MATCHES "^[.]+ (.+)$")
            abi_path(header "${CMAKE_MATCH_1}" "${working}")
            if(header MATCHES "/yvals_core[.]h$")
                if(NOT header STREQUAL "${resource}/include/yvals_core.h")
                    if(DEFINED unit_stl AND NOT unit_stl STREQUAL header)
                        abi_fail("Multiple STL implementation headers in one TU.")
                    endif()
                    set(unit_stl "${header}")
                endif()
            elseif(header MATCHES "/ucrt/corecrt[.]h$")
                set(unit_corecrt "${header}")
            elseif(header MATCHES "/shared/sdkddkver[.]h$")
                set(unit_sdkddkver "${header}")
            endif()
        endif()
    endforeach()
    foreach(header IN ITEMS "${unit_stl}" "${unit_corecrt}" "${unit_sdkddkver}")
        if(header STREQUAL "" OR NOT EXISTS "${header}")
            abi_fail("Compiler did not include a required actual STL/SDK header: ${header}")
        endif()
    endforeach()
    if(index EQUAL 0)
        set(stl_header "${unit_stl}")
        set(corecrt "${unit_corecrt}")
        set(sdkddkver "${unit_sdkddkver}")
        set(triple "${unit_triple}")
        set(witness_flags "${flags}")
        set(witness_working "${working}")
    elseif(NOT stl_header STREQUAL unit_stl OR NOT corecrt STREQUAL unit_corecrt OR
           NOT sdkddkver STREQUAL unit_sdkddkver OR NOT triple STREQUAL unit_triple)
        abi_fail("STL/SDK header provenance or target triple differs between TUs.")
    endif()
    set(unit "{}")
    foreach(key IN ITEMS source object macros driver headers directives)
        abi_quote(encoded "${${key}}")
        string(JSON unit SET "${unit}" "${key}" "${encoded}")
    endforeach()
    set(encoded_flags "[]")
    set(flag_index 0)
    foreach(flag IN LISTS flags)
        abi_quote(encoded "${flag}")
        string(JSON encoded_flags SET "${encoded_flags}" ${flag_index} "${encoded}")
        math(EXPR flag_index "${flag_index} + 1")
    endforeach()
    string(JSON unit SET "${unit}" arguments "${encoded_flags}")
    string(JSON units SET "${units}" ${index} "${unit}")
    list(APPEND all_objects "${object}")
    math(EXPR index "${index} + 1")
endforeach()

include("${CMAKE_CURRENT_LIST_DIR}/WindowsRuntime.cmake")

set(evidence "{}")
string(JSON evidence SET "${evidence}" schema 1)
foreach(key IN ITEMS target compiler triple stl_header sdk_manifest)
    abi_quote(encoded "${${key}}")
    string(JSON evidence SET "${evidence}" "${key}" "${encoded}")
endforeach()
abi_quote(encoded "${banner}")
string(JSON evidence SET "${evidence}" compiler_banner "${encoded}")
foreach(key IN ITEMS sdk_version toolset_version)
    abi_quote(encoded "${${key}}")
    string(JSON evidence SET "${evidence}" "${key}" "${encoded}")
endforeach()
set(sdk_headers "[]")
abi_quote(encoded "${corecrt}")
string(JSON sdk_headers SET "${sdk_headers}" 0 "${encoded}")
abi_quote(encoded "${sdkddkver}")
string(JSON sdk_headers SET "${sdk_headers}" 1 "${encoded}")
string(JSON evidence SET "${evidence}" sdk_headers "${sdk_headers}")
string(JSON evidence SET "${evidence}" runtime_libraries "${runtime_libraries}")
string(JSON evidence SET "${evidence}" units "${units}")
file(WRITE "${output}/compiler-evidence.json" "${evidence}\n")
# Prepare the scope document before publishing any successful Profile outputs.
file(WRITE "${output}/work/evidence.pending.json" "{\"schema\":1,\"scope\":\"controlled-windows-static-build\",\"all_translation_units\":true,\"runtime_link_witness\":true,\"binary_binding\":false,\"final_consumer_validated\":false}\n")
abi_run(mapper_report mapper_errors "${output}" "${tool}" --collect-windows "${output}/compiler-evidence.json" "${output}/profile.json")
abi_run(encoder_report encoder_errors "${output}" "${tool}" "${schema_file}" "${output}/profile.json"
    "${output}/canonical.json" "${output}/fingerprint.sha256")
# Scope is deliberately separate from the frozen Profile v1 byte protocol.
file(RENAME "${output}/work/evidence.pending.json" "${output}/evidence.json" RESULT scope_result)
if(NOT scope_result STREQUAL "0")
    abi_fail("Cannot publish collection scope: ${scope_result}")
endif()
message(STATUS "Collected Windows ABI Profile: ${target} (${index} TUs); final consumer and binary binding pending.")
