cmake_minimum_required(VERSION 4.0)

if(NOT DEFINED PANGU_ABI_OUTPUT OR PANGU_ABI_OUTPUT STREQUAL "")
    message(FATAL_ERROR "Missing PANGU_ABI_OUTPUT")
endif()
set(cleanup_errors "")
foreach(name IN ITEMS profile.json canonical.json fingerprint.sha256 evidence.json compiler-evidence.json)
    file(REMOVE "${PANGU_ABI_OUTPUT}/${name}")
    if(EXISTS "${PANGU_ABI_OUTPUT}/${name}")
        string(APPEND cleanup_errors "\n${PANGU_ABI_OUTPUT}/${name}")
    endif()
endforeach()
if(NOT cleanup_errors STREQUAL "")
    message(FATAL_ERROR "cleanup_incomplete: cannot invalidate previous ABI output:${cleanup_errors}")
endif()
