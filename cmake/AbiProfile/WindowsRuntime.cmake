# Included by CollectWindows.cmake after every real TU has been inspected.
if(NOT stl_header MATCHES "^(.*)/tools/msvc/([0-9.]+)/include/yvals_core[.]h$")
    abi_fail("STL header is outside a versioned MSVC toolset: ${stl_header}")
endif()
set(vc_root "${CMAKE_MATCH_1}")
set(toolset_version "${CMAKE_MATCH_2}")
set(toolset_root "${vc_root}/tools/msvc/${toolset_version}")
set(toolset_metadata "${vc_root}/auxiliary/build/Microsoft.VCToolsVersion.default.txt")
if(NOT EXISTS "${toolset_metadata}")
    abi_fail("Missing MSVC toolset version metadata: ${toolset_metadata}")
endif()
file(READ "${toolset_metadata}" selected_toolset)
string(STRIP "${selected_toolset}" selected_toolset)
if(NOT selected_toolset STREQUAL toolset_version)
    abi_fail("Selected STL toolset disagrees with installed toolset metadata.")
endif()
if(NOT corecrt MATCHES "^(.*)/include/([0-9.]+)/ucrt/corecrt[.]h$")
    abi_fail("CRT header is outside a versioned Windows SDK.")
endif()
set(sdk_root "${CMAKE_MATCH_1}")
set(sdk_version "${CMAKE_MATCH_2}")
if(NOT sdkddkver STREQUAL "${sdk_root}/include/${sdk_version}/shared/sdkddkver.h")
    abi_fail("UCRT and SDK header versions or roots disagree.")
endif()
set(sdk_manifest "${sdk_root}/platforms/uap/${sdk_version}/platform.xml")
if(NOT EXISTS "${sdk_manifest}")
    abi_fail("Missing actual SDK platform manifest: ${sdk_manifest}")
endif()
file(READ "${sdk_manifest}" manifest_text)
string(REGEX MATCH "<ApplicationPlatform[^>]* version=\"([^\"]+)\"" manifest_version "${manifest_text}")
if(NOT manifest_version OR NOT CMAKE_MATCH_1 STREQUAL sdk_version)
    abi_fail("Windows SDK manifest version disagrees with included headers.")
endif()

# This executable is never run. It forces standard-library/startup imports and
# links every actual object, rather than silently discarding unused archive members.
set(witness_source "${output}/work/runtime-witness.cpp")
set(witness_object "${output}/work/runtime-witness.obj")
set(witness_binary "${output}/work/runtime-witness.exe")
file(WRITE "${witness_source}" "#include <iostream>\n#include <string>\nint main(int argc, char** argv) { std::string value{argc > 0 ? argv[0] : \"\"}; std::cout << value; return static_cast<int>(value.empty()); }\n")
abi_run(ignored compile_errors "${witness_working}" "${compiler}" ${witness_flags}
    -c "${witness_source}" -o "${witness_object}")
abi_run(link_stdout link_stderr "${witness_working}" "${compiler}" -nostartfiles -nostdlib -fuse-ld=lld
    "${witness_object}" ${all_objects} -o "${witness_binary}" -Xlinker /subsystem:console -Xlinker /verbose -lkernel32)
set(link_trace "${link_stdout}\n${link_stderr}")
file(WRITE "${output}/work/runtime-link.log" "${link_trace}")
string(REPLACE "\r" "" link_lines "${link_trace}")
string(REPLACE "\n" ";" link_lines "${link_lines}")
set(libraries "")
foreach(line IN LISTS link_lines)
    if(line MATCHES "^lld-link: Reading (.+[.]lib)$")
        set(library "${CMAKE_MATCH_1}")
        if(IS_ABSOLUTE "${library}")
            abi_path(library "${library}" "${witness_working}")
            if(NOT EXISTS "${library}")
                abi_fail("Linker reported an unavailable import library: ${library}")
            endif()
            list(APPEND libraries "${library}")
        endif()
    endif()
endforeach()
list(REMOVE_DUPLICATES libraries)
if(NOT libraries)
    abi_fail("The actual linker did not report any resolved runtime libraries.")
endif()
set(runtime_libraries "[]")
set(library_index 0)
foreach(library IN LISTS libraries)
    # Restrict the witness to the same actual SDK/toolset as the headers.
    string(FIND "${library}" "${toolset_root}/lib/x64/" toolset_prefix)
    string(FIND "${library}" "${sdk_root}/lib/${sdk_version}/" sdk_prefix)
    if(NOT toolset_prefix EQUAL 0 AND NOT sdk_prefix EQUAL 0)
        abi_fail("Linker resolved a library outside the observed SDK/toolset: ${library}")
    endif()
    abi_quote(encoded "${library}")
    string(JSON runtime_libraries SET "${runtime_libraries}" ${library_index} "${encoded}")
    math(EXPR library_index "${library_index} + 1")
endforeach()
