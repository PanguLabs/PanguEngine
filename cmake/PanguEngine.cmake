include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/PanguBuildLayout.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/PanguRuntimeDeployment.cmake")

function(pangu_add_engine)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "SOURCE_DIR;ENGINE_BUILD_ROOT" "")
    if(arg_UNPARSED_ARGUMENTS OR arg_KEYWORDS_MISSING_VALUES OR NOT arg_SOURCE_DIR OR NOT arg_ENGINE_BUILD_ROOT)
        message(FATAL_ERROR "pangu_add_engine requires SOURCE_DIR ENGINE_BUILD_ROOT")
    endif()
    if(NOT IS_ABSOLUTE "${arg_ENGINE_BUILD_ROOT}")
        message(FATAL_ERROR "Pangu Engine build root must be absolute")
    endif()
    set(PANGU_ENGINE_BUILD_ROOT "${arg_ENGINE_BUILD_ROOT}" CACHE PATH "Shared Engine artifact root" FORCE)
    set(PANGU_ENGINE_SOURCE_DIR "${arg_SOURCE_DIR}" PARENT_SCOPE)
    set(PANGU_SOURCE_OWNER project PARENT_SCOPE)
    add_subdirectory("${arg_SOURCE_DIR}" "${arg_ENGINE_BUILD_ROOT}/Targets/Engine")
endfunction()
