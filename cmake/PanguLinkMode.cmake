include_guard(GLOBAL)

function(pangu_initialize_link_mode)
    if(NOT DEFINED PANGU_LINK_MODE)
        if(CMAKE_SYSTEM_NAME STREQUAL "Android" OR CMAKE_SYSTEM_NAME STREQUAL "iOS")
            set(defaultMode Monolithic)
        else()
            set(defaultMode Modular)
        endif()
        set(PANGU_LINK_MODE "${defaultMode}" CACHE STRING "Pangu Module link mode")
    endif()
    if(NOT PANGU_LINK_MODE STREQUAL "Monolithic" AND NOT PANGU_LINK_MODE STREQUAL "Modular")
        message(FATAL_ERROR "Invalid PANGU_LINK_MODE '${PANGU_LINK_MODE}'; expected Monolithic or Modular.")
    endif()
    get_property(initialMode GLOBAL PROPERTY PANGU_INITIAL_LINK_MODE)
    if(initialMode AND NOT initialMode STREQUAL PANGU_LINK_MODE)
        message(FATAL_ERROR "Invalid PANGU_LINK_MODE: changed from '${initialMode}' to '${PANGU_LINK_MODE}' in one target graph.")
    endif()
    set_property(GLOBAL PROPERTY PANGU_INITIAL_LINK_MODE "${PANGU_LINK_MODE}")
    if(DEFINED CACHE{PANGU_LINK_MODE})
        set_property(CACHE PANGU_LINK_MODE PROPERTY STRINGS Monolithic Modular)
    endif()
endfunction()

function(pangu_module_library_type outVar)
    pangu_initialize_link_mode()
    if(PANGU_LINK_MODE STREQUAL "Modular")
        set(${outVar} SHARED PARENT_SCOPE)
    else()
        set(${outVar} STATIC PARENT_SCOPE)
    endif()
endfunction()
