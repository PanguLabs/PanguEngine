include_guard(GLOBAL)

function(pangu_test_context)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "OWNER;ENABLED;PLUGIN_ID" "")
    string(TOUPPER "${arg_ENABLED}" enabled)
    if(arg_UNPARSED_ARGUMENTS OR arg_KEYWORDS_MISSING_VALUES OR
       NOT arg_OWNER MATCHES "^(engine|project)$" OR
       NOT DEFINED arg_ENABLED OR NOT enabled MATCHES "^(ON|OFF|TRUE|FALSE|YES|NO|Y|N|1|0)$")
        message(FATAL_ERROR "pangu_test_context requires OWNER engine|project and ENABLED <bool>")
    endif()
    if(DEFINED arg_PLUGIN_ID AND NOT arg_PLUGIN_ID MATCHES "^[a-z0-9][a-z0-9_.-]*$")
        message(FATAL_ERROR "Invalid PLUGIN_ID: ${arg_PLUGIN_ID}")
    endif()
    set(PANGU_TEST_OWNER "${arg_OWNER}" PARENT_SCOPE)
    set(PANGU_TEST_ENABLED "${enabled}" PARENT_SCOPE)
    set(PANGU_TEST_PLUGIN_ID "${arg_PLUGIN_ID}" PARENT_SCOPE)
endfunction()

function(pangu_tests_enabled output)
    if(NOT ARGC EQUAL 1 OR output STREQUAL "")
        message(FATAL_ERROR "pangu_tests_enabled requires one output variable")
    endif()
    if(BUILD_TESTING AND PANGU_TEST_ENABLED AND NOT CMAKE_CROSSCOMPILING)
        set(${output} ON PARENT_SCOPE)
    else()
        set(${output} OFF PARENT_SCOPE)
    endif()
endfunction()

function(_pangu_test_metadata prefix)
    if(NOT PANGU_TEST_OWNER MATCHES "^(engine|project)$")
        message(FATAL_ERROR "Test OWNER context missing or invalid; call pangu_test_context first")
    endif()
    pangu_tests_enabled(enabled)
    if(NOT enabled)
        message(FATAL_ERROR "Test registration requires an enabled native testing context")
    endif()
    if(NOT ${prefix}_BOUNDARY MATCHES "^(unit|integration|system)$")
        message(FATAL_ERROR "Test BOUNDARY must be unit|integration|system")
    endif()
    if(NOT ${prefix}_AREA MATCHES "^[a-z0-9][a-z0-9-]*$")
        message(FATAL_ERROR "Test AREA must be a lowercase slug")
    endif()
    if(NOT ${prefix}_TIER MATCHES "^(fast|precommit|full)$")
        message(FATAL_ERROR "Test TIER must be fast|precommit|full")
    endif()
    set(labels "boundary.${${prefix}_BOUNDARY}" "area.${${prefix}_AREA}" "owner.${PANGU_TEST_OWNER}")
    set(tiers fast precommit full)
    list(FIND tiers "${${prefix}_TIER}" start)
    list(SUBLIST tiers ${start} -1 tiers)
    foreach(tier IN LISTS tiers)
        list(APPEND labels "run.${tier}")
    endforeach()
    if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
        set(platform macos)
    else()
        string(TOLOWER "${CMAKE_SYSTEM_NAME}" platform)
    endif()
    list(APPEND labels "platform.${platform}")
    foreach(type IN LISTS ${prefix}_TYPES)
        if(NOT type MATCHES "^(contract|regression)$")
            message(FATAL_ERROR "Invalid test TYPES: ${type}")
        endif()
        list(APPEND labels "type.${type}")
    endforeach()
    foreach(requirement IN LISTS ${prefix}_REQUIRES)
        if(NOT requirement MATCHES "^(threads|subprocess|nested-build)$")
            message(FATAL_ERROR "Invalid test REQUIRES: ${requirement}")
        endif()
        list(APPEND labels "requires.${requirement}")
    endforeach()
    if(PANGU_TEST_PLUGIN_ID)
        if(NOT PANGU_TEST_PLUGIN_ID MATCHES "^[a-z0-9][a-z0-9_.-]*$")
            message(FATAL_ERROR "Invalid test PLUGIN_ID context")
        endif()
        list(APPEND labels "plugin.${PANGU_TEST_PLUGIN_ID}")
    endif()
    list(REMOVE_DUPLICATES labels)
    if(DEFINED ${prefix}_TIMEOUT)
        set(timeout "${${prefix}_TIMEOUT}")
        if(NOT timeout MATCHES "^[0-9]+([.][0-9]+)?$" OR NOT timeout GREATER 0)
            message(FATAL_ERROR "Test TIMEOUT must be positive seconds")
        endif()
    elseif(${prefix}_BOUNDARY STREQUAL "unit")
        set(timeout 30)
    elseif(${prefix}_BOUNDARY STREQUAL "integration")
        set(timeout 60)
    else()
        set(timeout 300)
    endif()
    set(_pangu_labels "${labels}" PARENT_SCOPE)
    set(_pangu_timeout "${timeout}" PARENT_SCOPE)
endfunction()

function(pangu_test_build_dependencies)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "TIER" "TARGETS")
    if(arg_UNPARSED_ARGUMENTS OR arg_KEYWORDS_MISSING_VALUES OR
       NOT arg_TIER MATCHES "^(fast|precommit|full)$" OR NOT arg_TARGETS)
        message(FATAL_ERROR "pangu_test_build_dependencies requires TIER fast|precommit|full and TARGETS")
    endif()
    foreach(dependency IN LISTS arg_TARGETS)
        if(NOT TARGET "${dependency}")
            message(FATAL_ERROR "Test build dependency target missing: ${dependency}")
        endif()
    endforeach()
    set(tiers fast precommit full)
    list(FIND tiers "${arg_TIER}" start)
    list(SUBLIST tiers ${start} -1 tiers)
    foreach(tier IN LISTS tiers)
        if(tier STREQUAL "fast")
            set(target PanguTestsFast)
        elseif(tier STREQUAL "precommit")
            set(target PanguTestsPrecommit)
        else()
            set(target PanguTestsFull)
        endif()
        if(NOT TARGET "${target}")
            add_custom_target("${target}")
        endif()
        add_dependencies("${target}" ${arg_TARGETS})
    endforeach()
endfunction()

function(_pangu_claim_test kind name)
    string(SHA256 key "${kind}:${name}")
    get_property(registered GLOBAL PROPERTY "PANGU_TEST_REGISTERED_${key}")
    if(registered)
        message(FATAL_ERROR "Test ${kind} '${name}' already registered")
    endif()
    set_property(GLOBAL PROPERTY "PANGU_TEST_REGISTERED_${key}" ON)
endfunction()

function(pangu_register_gtest)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "TARGET;BOUNDARY;AREA;TIER;TIMEOUT" "TYPES;REQUIRES")
    if(arg_UNPARSED_ARGUMENTS OR arg_KEYWORDS_MISSING_VALUES OR NOT arg_TARGET OR NOT TARGET "${arg_TARGET}")
        message(FATAL_ERROR "pangu_register_gtest requires an existing TARGET and valid arguments")
    endif()
    get_target_property(kind "${arg_TARGET}" TYPE)
    if(NOT kind STREQUAL "EXECUTABLE")
        message(FATAL_ERROR "GoogleTest TARGET must be an executable")
    endif()
    _pangu_test_metadata(arg)
    _pangu_claim_test(target "${arg_TARGET}")
    pangu_test_build_dependencies(TIER "${arg_TIER}" TARGETS "${arg_TARGET}")
    include(GoogleTest)
    string(SHA256 key "${arg_TARGET}")
    set(testList "_pangu_discovered_${key}")
    set(testRoot "${CMAKE_BINARY_DIR}/Tests")
    set(testTarget "${arg_TARGET}")
    file(MAKE_DIRECTORY "${testRoot}/Results/${testTarget}")
    gtest_discover_tests("${arg_TARGET}" TEST_PREFIX "${arg_TARGET}."
        NO_PRETTY_TYPES NO_PRETTY_VALUES DISCOVERY_MODE PRE_TEST
        TEST_LIST "${testList}" XML_OUTPUT_DIR "${testRoot}/Results/${testTarget}"
        PROPERTIES LABELS "${_pangu_labels}" TIMEOUT "${_pangu_timeout}")
    set(configured "${CMAKE_CURRENT_BINARY_DIR}/${testTarget}_work.cmake")
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/Testing/ConfigureDiscoveredTests.cmake.in"
        "${configured}" @ONLY)
    set_property(DIRECTORY APPEND PROPERTY TEST_INCLUDE_FILES "${configured}")
endfunction()

function(pangu_register_test)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "NAME;BOUNDARY;AREA;TIER;PROCESSORS;TIMEOUT"
        "COMMAND;BUILD_TARGETS;TYPES;REQUIRES")
    if(arg_UNPARSED_ARGUMENTS OR arg_KEYWORDS_MISSING_VALUES OR NOT arg_NAME OR NOT arg_COMMAND)
        message(FATAL_ERROR "pangu_register_test requires NAME, COMMAND and valid arguments")
    endif()
    if(DEFINED arg_PROCESSORS AND (NOT arg_PROCESSORS MATCHES "^[1-9][0-9]*$"))
        message(FATAL_ERROR "Test PROCESSORS must be a positive integer")
    endif()
    _pangu_test_metadata(arg)
    _pangu_claim_test(name "${arg_NAME}")
    if(arg_BUILD_TARGETS)
        pangu_test_build_dependencies(TIER "${arg_TIER}" TARGETS ${arg_BUILD_TARGETS})
    else()
        # 脚本测试也应建立累计构建入口，但不虚构生产依赖。
        if(NOT TARGET PanguTestsFull)
            add_custom_target(PanguTestsFull)
        endif()
        if(NOT arg_TIER STREQUAL "full" AND NOT TARGET PanguTestsPrecommit)
            add_custom_target(PanguTestsPrecommit)
        endif()
        if(arg_TIER STREQUAL "fast" AND NOT TARGET PanguTestsFast)
            add_custom_target(PanguTestsFast)
        endif()
    endif()
    string(SHA256 hash "${arg_NAME}")
    set(work "${CMAKE_BINARY_DIR}/Tests/Work/${hash}")
    file(MAKE_DIRECTORY "${work}")
    add_test(NAME "${arg_NAME}" COMMAND ${arg_COMMAND})
    set_tests_properties("${arg_NAME}" PROPERTIES LABELS "${_pangu_labels}"
        TIMEOUT "${_pangu_timeout}" WORKING_DIRECTORY "${work}")
    if(DEFINED arg_PROCESSORS)
        set_tests_properties("${arg_NAME}" PROPERTIES PROCESSORS "${arg_PROCESSORS}")
    endif()
endfunction()

function(pangu_require_full_testing)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "OWNER" "")
    if(arg_UNPARSED_ARGUMENTS OR arg_KEYWORDS_MISSING_VALUES OR NOT arg_OWNER MATCHES "^(engine|project)$")
        message(FATAL_ERROR "pangu_require_full_testing requires OWNER engine|project")
    endif()
    if(arg_OWNER STREQUAL "project")
        return()
    endif()
    if(NOT TARGET PanguTestsFull)
        add_custom_target(PanguTestsFull)
    endif()
    if(NOT TARGET PanguValidateEngineFullTesting)
        set(parameters "${CMAKE_CURRENT_BINARY_DIR}/PanguFullTestingParameters.cmake")
        file(WRITE "${parameters}" "set(BUILD_TESTING [==[${BUILD_TESTING}]==])\nset(PANGU_BUILD_ENGINE_TESTS [==[${PANGU_BUILD_ENGINE_TESTS}]==])\n")
        add_custom_target(PanguValidateEngineFullTesting
            COMMAND "${CMAKE_COMMAND}" "-DPANGU_FULL_PARAMETERS=${parameters}"
                -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/Testing/ValidateFullTesting.cmake"
            VERBATIM)
    endif()
    add_dependencies(PanguTestsFull PanguValidateEngineFullTesting)
endfunction()
