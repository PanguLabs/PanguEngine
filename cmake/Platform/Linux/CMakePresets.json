{
  "version": 9,
  "include": [
    "../Common/CMakePresets.json"
  ],
  "configurePresets": [
    {
      "name": "linux",
      "displayName": "Linux Clang 23 / libc++ / Ninja",
      "inherits": "pangu-ninja",
      "binaryDir": "$env{HOME}/PanguEngineBuild/Linux",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "toolchainFile": "${sourceDir}/cmake/Platform/Linux/Toolchain.cmake",
      "cacheVariables": {
        "PANGU_LINK_MODE": "Modular",
        "CMAKE_CXX_COMPILER_CLANG_SCAN_DEPS": "$env{LLVM_ROOT}/bin/clang-scan-deps"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux",
      "configurePreset": "linux"
    },
    {
      "name": "linux-fast",
      "configurePreset": "linux",
      "targets": [
        "PanguTestsFast"
      ],
      "jobs": 1
    },
    {
      "name": "linux-precommit",
      "configurePreset": "linux",
      "targets": [
        "PanguTestsPrecommit"
      ],
      "jobs": 1
    },
    {
      "name": "linux-full",
      "configurePreset": "linux",
      "targets": [
        "PanguTestsFull"
      ],
      "jobs": 1
    }
  ],
  "testPresets": [
    {
      "name": "linux",
      "configurePreset": "linux",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "linux-fast",
      "configurePreset": "linux",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "filter": {
        "include": {
          "label": "^run\\.fast$"
        }
      }
    },
    {
      "name": "linux-precommit",
      "configurePreset": "linux",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "filter": {
        "include": {
          "label": "^run\\.precommit$"
        }
      }
    },
    {
      "name": "linux-full",
      "configurePreset": "linux",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "linux-fast",
      "steps": [
        {
          "type": "configure",
          "name": "linux"
        },
        {
          "type": "build",
          "name": "linux-fast"
        },
        {
          "type": "test",
          "name": "linux-fast"
        }
      ]
    },
    {
      "name": "linux-precommit",
      "steps": [
        {
          "type": "configure",
          "name": "linux"
        },
        {
          "type": "build",
          "name": "linux-precommit"
        },
        {
          "type": "test",
          "name": "linux-precommit"
        }
      ]
    },
    {
      "name": "linux-full",
      "steps": [
        {
          "type": "configure",
          "name": "linux"
        },
        {
          "type": "build",
          "name": "linux-full"
        },
        {
          "type": "test",
          "name": "linux-full"
        }
      ]
    }
  ]
}
