{
  "version": 9,
  "include": [
    "../Common/CMakePresets.json"
  ],
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows Clang 23 / Ninja",
      "inherits": "pangu-ninja",
      "binaryDir": "${sourceDir}/Build/Windows",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "$env{LLVM_ROOT}/bin/clang++.exe",
        "CMAKE_CXX_COMPILER_CLANG_SCAN_DEPS": "$env{LLVM_ROOT}/bin/clang-scan-deps.exe"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows",
      "configurePreset": "windows"
    },
    {
      "name": "windows-fast",
      "configurePreset": "windows",
      "targets": [
        "PanguTestsFast"
      ],
      "jobs": 1
    },
    {
      "name": "windows-precommit",
      "configurePreset": "windows",
      "targets": [
        "PanguTestsPrecommit"
      ],
      "jobs": 1
    },
    {
      "name": "windows-full",
      "configurePreset": "windows",
      "targets": [
        "PanguTestsFull"
      ],
      "jobs": 1
    }
  ],
  "testPresets": [
    {
      "name": "windows",
      "configurePreset": "windows",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-fast",
      "configurePreset": "windows",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "filter": {
        "include": {
          "label": "^run\\.fast$"
        }
      }
    },
    {
      "name": "windows-precommit",
      "configurePreset": "windows",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "filter": {
        "include": {
          "label": "^run\\.precommit$"
        }
      }
    },
    {
      "name": "windows-full",
      "configurePreset": "windows",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "windows-fast",
      "steps": [
        {
          "type": "configure",
          "name": "windows"
        },
        {
          "type": "build",
          "name": "windows-fast"
        },
        {
          "type": "test",
          "name": "windows-fast"
        }
      ]
    },
    {
      "name": "windows-precommit",
      "steps": [
        {
          "type": "configure",
          "name": "windows"
        },
        {
          "type": "build",
          "name": "windows-precommit"
        },
        {
          "type": "test",
          "name": "windows-precommit"
        }
      ]
    },
    {
      "name": "windows-full",
      "steps": [
        {
          "type": "configure",
          "name": "windows"
        },
        {
          "type": "build",
          "name": "windows-full"
        },
        {
          "type": "test",
          "name": "windows-full"
        }
      ]
    }
  ]
}
