cmake_minimum_required(VERSION 4.0)
set(files [==[@files@]==])
set(destination [==[@destination@]==])
set(buildRoot [==[@CMAKE_BINARY_DIR@]==])
set(ownedDirectory [==[@ownedDirectory@]==])
set(graphicsFiles [==[@graphicsFiles@]==])
set(agilityFiles [==[@agilityFiles@]==])

function(_pangu_escape_deploy_dependency output path)
    file(RELATIVE_PATH relative "${buildRoot}" "${path}")
    string(REPLACE "$" "$$" relative "${relative}")
    string(REPLACE "#" "\\#" relative "${relative}")
    string(REPLACE " " "\\ " relative "${relative}")
    set("${output}" "${relative}" PARENT_SCOPE)
endfunction()

if(CMAKE_HOST_APPLE)
    include([==[@CMAKE_CURRENT_FUNCTION_LIST_DIR@/StageRuntimeFramework.cmake]==])
endif()

file(MAKE_DIRECTORY "${destination}")
file(MAKE_DIRECTORY "${ownedDirectory}")
file(REAL_PATH "${destination}" destinationPath)
set(dependencies)
set(currentNames)
set(inputs
    ${files}
    ${graphicsFiles}
    ${agilityFiles}
)
list(REMOVE_DUPLICATES inputs)
foreach(file IN LISTS inputs)
    if(CMAKE_HOST_APPLE AND file MATCHES "^(.+/[^/]+[.]framework)/")
        set(bundle "${CMAKE_MATCH_1}")
        cmake_path(GET bundle FILENAME name)
        if(NOT name IN_LIST currentNames)
            list(APPEND currentNames "${name}")
            _pangu_stage_framework("${bundle}" "${name}")
        endif()
        continue()
    endif()
    get_filename_component(name "${file}" NAME)
    if(file IN_LIST agilityFiles)
        if(IS_SYMLINK "${destination}/D3D12")
            message(FATAL_ERROR "Agility SDK deployment directory is a symbolic link: ${destination}/D3D12")
        endif()
        file(
            MAKE_DIRECTORY
                "${destination}/D3D12"
                "${ownedDirectory}/D3D12"
        )
        set(name "D3D12/${name}")
    elseif(file IN_LIST graphicsFiles AND name MATCHES "^(pc|apple)_gpu[.]data$")
        set(name "gpu.data")
    endif()
    set(copy "${destination}/${name}")
    set(nameKey "${name}")
    if(CMAKE_HOST_WIN32)
        string(TOLOWER "${nameKey}" nameKey)
    endif()
    list(APPEND currentNames "${nameKey}")
    set(recordCopy OFF)
    file(REAL_PATH "${file}" sourcePath)
    set(copyPath "${destinationPath}/${name}")
    if(IS_SYMLINK "${copy}" AND EXISTS "${copy}")
        file(REAL_PATH "${copy}" copyPath)
    endif()
    if(CMAKE_HOST_WIN32)
        string(TOLOWER "${sourcePath}" sourcePath)
        string(TOLOWER "${copyPath}" copyPath)
    endif()
    if(sourcePath STREQUAL copyPath)
        # 目标直接输出到部署目录时，该文件由链接器管理。
        file(REMOVE "${ownedDirectory}/${name}")
    else()
        file(SHA256 "${file}" sourceHash)
        set(recordCopy ON)
        if(EXISTS "${copy}" AND NOT EXISTS "${ownedDirectory}/${name}")
            file(SHA256 "${copy}" existingHash)
            if(existingHash STREQUAL sourceHash)
                set(recordCopy OFF)
            endif()
        endif()
    endif()
    execute_process(
        COMMAND
            "${CMAKE_COMMAND}" -E copy_if_different "${file}" "${copy}"
        COMMAND_ERROR_IS_FATAL ANY
    )
    if(recordCopy)
        file(WRITE "${ownedDirectory}.tmp" "${sourceHash}\n${copy}")
        file(RENAME "${ownedDirectory}.tmp" "${ownedDirectory}/${name}")
    endif()
    _pangu_escape_deploy_dependency(dependency "${copy}")
    string(APPEND dependencies " ${dependency}")
endforeach()

file(GLOB_RECURSE recorded RELATIVE "${ownedDirectory}" "${ownedDirectory}/*")
foreach(name IN LISTS recorded)
    set(nameKey "${name}")
    if(CMAKE_HOST_WIN32)
        string(TOLOWER "${nameKey}" nameKey)
    endif()
    if(nameKey IN_LIST currentNames)
        continue()
    endif()
    set(copy "${destination}/${name}")
    if(name MATCHES "^D3D12/" AND IS_SYMLINK "${destination}/D3D12")
        # 用户替换了子目录，旧归属不再适用。
    elseif(CMAKE_HOST_APPLE AND name MATCHES "[.]framework$" AND IS_DIRECTORY "${copy}" AND NOT IS_SYMLINK "${copy}")
        file(READ "${ownedDirectory}/${name}" record)
        _pangu_framework_digest("${copy}" actualHash)
        if(record STREQUAL "${actualHash}\n${copy}")
            file(REMOVE_RECURSE "${copy}")
            if(EXISTS "${copy}")
                message(FATAL_ERROR "Could not remove obsolete framework: ${copy}")
            endif()
        endif()
    elseif(EXISTS "${copy}" AND NOT IS_DIRECTORY "${copy}" AND NOT IS_SYMLINK "${copy}")
        file(READ "${ownedDirectory}/${name}" record)
        file(SHA256 "${copy}" actualHash)
        set(expected "${actualHash}\n${copy}")
        if(CMAKE_HOST_WIN32)
            string(TOLOWER "${expected}" expected)
            string(TOLOWER "${record}" record)
        endif()
        if(record STREQUAL expected)
            file(REMOVE "${copy}")
            if(EXISTS "${copy}")
                message(FATAL_ERROR "Could not remove obsolete runtime copy: ${copy}")
            endif()
        endif()
    endif()
    file(REMOVE "${ownedDirectory}/${name}")
endforeach()
_pangu_escape_deploy_dependency(output [==[@stamp@]==])
file(WRITE [==[@depfile@]==] "${output}:${dependencies}\n")
