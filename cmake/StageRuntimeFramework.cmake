# Framework 的 install name 指向包内的二进制；资源和相对符号链接共同构成部署单元。
function(_pangu_framework_digest bundle output)
    file(GLOB_RECURSE entries LIST_DIRECTORIES TRUE RELATIVE "${bundle}" "${bundle}/*")
    set(tree "")
    foreach(entry IN LISTS entries)
        set(path "${bundle}/${entry}")
        if(IS_SYMLINK "${path}")
            file(READ_SYMLINK "${path}" link)
            set(identity "link:${link}")
        elseif(IS_DIRECTORY "${path}")
            set(identity "directory")
        else()
            file(SHA256 "${path}" identity)
        endif()
        string(SHA256 member "${entry}:${identity}")
        string(APPEND tree "${member}")
    endforeach()
    string(SHA256 digest "${tree}")
    set("${output}" "${digest}" PARENT_SCOPE)
    if(ARGC GREATER 2)
        list(TRANSFORM entries PREPEND "${bundle}/")
        set("${ARGV2}" "${bundle};${entries}" PARENT_SCOPE)
    endif()
endfunction()

function(_pangu_stage_framework bundle name)
    file(REAL_PATH "${bundle}" source)
    set(copy "${destination}/${name}")
    set(marker "${ownedDirectory}/${name}")
    if(IS_SYMLINK "${copy}")
        message(FATAL_ERROR "Framework deployment path is a symbolic link: ${copy}")
    endif()
    _pangu_framework_digest("${source}" sourceHash sourceMembers)
    if(source STREQUAL "${destinationPath}/${name}")
        file(REMOVE "${marker}")
        set(copyMembers)
    else()
        set(previousHash "")
        set(syncOptions)
        if(IS_DIRECTORY "${copy}")
            _pangu_framework_digest("${copy}" previousHash)
            if(EXISTS "${marker}")
                file(READ "${marker}" record)
                if(record STREQUAL "${previousHash}\n${copy}")
                    list(APPEND syncOptions --delete)
                endif()
            endif()
        endif()
        execute_process(
            COMMAND
                /usr/bin/rsync -a --checksum ${syncOptions} "${source}/" "${copy}/"
            COMMAND_ERROR_IS_FATAL ANY
        )
        if(NOT previousHash STREQUAL sourceHash OR EXISTS "${marker}")
            file(WRITE "${marker}.tmp" "${sourceHash}\n${copy}")
            file(RENAME "${marker}.tmp" "${marker}")
        endif()
        # 仅跟踪源包要求的目标成员，用户添加的文件不构成构建输入。
        set(copyMembers)
        foreach(member IN LISTS sourceMembers)
            file(
                RELATIVE_PATH
                relative
                "${source}"
                "${member}"
            )
            list(APPEND copyMembers "${copy}/${relative}")
        endforeach()
    endif()
    foreach(member IN LISTS sourceMembers copyMembers)
        _pangu_escape_deploy_dependency(escaped "${member}")
        string(APPEND dependencies " ${escaped}")
    endforeach()
    set(dependencies "${dependencies}" PARENT_SCOPE)
endfunction()
