cmake_minimum_required(VERSION 4.0)
foreach(required IN ITEMS BINARY_DIR REGEX RESULT_DIR JOBS)
    if(NOT DEFINED PANGU_BUILD_TOOLS_TEST_${required} OR "${PANGU_BUILD_TOOLS_TEST_${required}}" STREQUAL "")
        message(FATAL_ERROR "PANGU_BUILD_TOOLS_TEST_${required} is required")
    endif()
endforeach()
if(NOT PANGU_BUILD_TOOLS_TEST_JOBS MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "PANGU_BUILD_TOOLS_TEST_JOBS must be a positive integer")
endif()
file(MAKE_DIRECTORY "${PANGU_BUILD_TOOLS_TEST_RESULT_DIR}")
string(TIMESTAMP stamp "%Y%m%dT%H%M%S" UTC)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
set(prefix "${PANGU_BUILD_TOOLS_TEST_RESULT_DIR}/${stamp}-${nonce}")
execute_process(COMMAND "${CMAKE_CTEST_COMMAND}"
    --test-dir "${PANGU_BUILD_TOOLS_TEST_BINARY_DIR}"
    -R "${PANGU_BUILD_TOOLS_TEST_REGEX}" --no-tests=error --output-on-failure
    --parallel "${PANGU_BUILD_TOOLS_TEST_JOBS}" --output-junit "${prefix}.xml"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
file(WRITE "${prefix}.log" "${output}\n${error}")
message("${output}\n${error}")
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "BuildTools CTest failed (${result}); preserved results: ${prefix}")
endif()
if(NOT EXISTS "${prefix}.xml")
    message(FATAL_ERROR "BuildTools CTest produced no JUnit report: ${prefix}")
endif()
file(READ "${prefix}.xml" xml)
if(xml MATCHES "<skipped[ />]" OR xml MATCHES "status=\"(disabled|notrun)\"")
    message(FATAL_ERROR "BuildTools critical test skipped; preserved results: ${prefix}")
endif()
