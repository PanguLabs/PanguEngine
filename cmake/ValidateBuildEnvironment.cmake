# Executed before project(): Preset paths must be checked before compiler discovery.
# Android's official NDK toolchain is selected by CMAKE_TOOLCHAIN_FILE.
if("${CMAKE_TOOLCHAIN_FILE}" MATCHES "android[.]toolchain[.]cmake$")
    if("$ENV{ANDROID_HOME}" STREQUAL "" OR NOT IS_DIRECTORY "$ENV{ANDROID_HOME}")
        message(FATAL_ERROR "Pangu Android preflight: set ANDROID_HOME to the Android SDK root.")
    endif()
    if("$ENV{ANDROID_NDK_HOME}" STREQUAL "" OR NOT IS_DIRECTORY "$ENV{ANDROID_NDK_HOME}")
        message(FATAL_ERROR "Pangu Android preflight: set ANDROID_NDK_HOME to the selected NDK root.")
    endif()
    if(NOT EXISTS "$ENV{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake")
        message(FATAL_ERROR "Pangu Android preflight: NDK toolchain file missing under ANDROID_NDK_HOME.")
    endif()
else()
    if("$ENV{LLVM_ROOT}" STREQUAL "" OR NOT IS_DIRECTORY "$ENV{LLVM_ROOT}")
        message(FATAL_ERROR "Pangu Clang preflight: set LLVM_ROOT to the selected LLVM 23 installation root.")
    endif()
    if(WIN32)
        set(_pangu_exe_suffix ".exe")
    else()
        set(_pangu_exe_suffix "")
    endif()
    foreach(_pangu_tool IN ITEMS clang++ clang-scan-deps)
        if(NOT EXISTS "$ENV{LLVM_ROOT}/bin/${_pangu_tool}${_pangu_exe_suffix}")
            message(FATAL_ERROR
                "Pangu Clang preflight: missing ${_pangu_tool}${_pangu_exe_suffix} under LLVM_ROOT/bin.")
        endif()
    endforeach()
    unset(_pangu_exe_suffix)
    unset(_pangu_tool)
endif()
