{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PanguLabs/PanguEngine/wiki/foundation/abi-profile-v1.schema.json",
  "title": "PanguEngine ABI Profile v1",
  "description": "Structure, enumerations and supported target combinations; see abi-profile-fingerprint.md for raw JSON validation, build provenance, canonicalization and ABI policies.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy",
    "target",
    "compiler",
    "language",
    "stdlib",
    "runtime"
  ],
  "properties": {
    "schema": {
      "type": "integer",
      "const": 1
    },
    "policy": {
      "const": "strict-v1",
      "type": "string"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "triple",
        "object",
        "pointer_bits",
        "endian",
        "cpu_abi"
      ],
      "properties": {
        "triple": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:x86_64|amd64|aarch64|arm64|armv7a?|thumbv7|i[3-6]86|x86)-[a-z0-9_][a-z0-9_.-]*(?![\\s\\S])"
        },
        "object": {
          "type": "string",
          "enum": [
            "coff",
            "elf",
            "macho"
          ]
        },
        "pointer_bits": {
          "type": "string",
          "enum": [
            "32",
            "64"
          ]
        },
        "endian": {
          "type": "string",
          "enum": [
            "little",
            "big"
          ]
        },
        "cpu_abi": {
          "type": "string",
          "enum": [
            "baseline-x86_64",
            "x86_64-v2",
            "x86_64-v3",
            "x86_64-v4",
            "baseline-x86",
            "aapcs64",
            "aapcs32"
          ]
        }
      }
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "distribution",
        "version",
        "cxx_abi"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "clang"
          ]
        },
        "distribution": {
          "type": "string",
          "enum": [
            "llvm-upstream",
            "macports",
            "android-ndk"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?![\\s\\S])"
        },
        "cxx_abi": {
          "type": "string",
          "enum": [
            "msvc",
            "itanium"
          ]
        }
      }
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standard",
        "exceptions",
        "rtti",
        "abi_options"
      ],
      "properties": {
        "standard": {
          "type": "string",
          "enum": [
            "c++23"
          ]
        },
        "exceptions": {
          "type": "string",
          "enum": [
            "off"
          ]
        },
        "rtti": {
          "type": "string",
          "enum": [
            "on",
            "off"
          ]
        },
        "abi_options": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "prefixItems": [
            {
              "type": "string",
              "pattern": "^bitfield_layout=(msvc|itanium)(?![\\s\\S])"
            },
            {
              "type": "string",
              "enum": [
                "calling_convention=msvc",
                "calling_convention=sysv",
                "calling_convention=aapcs",
                "calling_convention=aapcs64"
              ]
            },
            {
              "type": "string",
              "pattern": "^char_signedness=(signed|unsigned)(?![\\s\\S])"
            },
            {
              "type": "string",
              "pattern": "^enum_width=(native|short)(?![\\s\\S])"
            },
            {
              "type": "string",
              "pattern": "^float_abi=(default|soft|hard)(?![\\s\\S])"
            },
            {
              "type": "string",
              "pattern": "^struct_pack=(default|pack1|pack2|pack4|pack8|pack16)(?![\\s\\S])"
            },
            {
              "type": "string",
              "enum": [
                "vector_abi=default",
                "vector_abi=msvc-vectorcall",
                "vector_abi=sysv-vector",
                "vector_abi=aapcs64"
              ]
            },
            {
              "type": "string",
              "pattern": "^wchar_width=(16|32)(?![\\s\\S])"
            }
          ]
        }
      }
    },
    "stdlib": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "abi_version",
        "abi_namespace",
        "iterator_debug_level"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "msvc-stl",
            "libc++"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+)*(?:[-_.][a-z0-9]+)*(?![\\s\\S])"
        },
        "abi_version": {
          "type": "string",
          "pattern": "^(?:na|[0-9]+|msvc-stl-[0-9]+)(?![\\s\\S])"
        },
        "abi_namespace": {
          "type": "string",
          "pattern": "^(?:na|__[a-z0-9_]+)(?![\\s\\S])"
        },
        "iterator_debug_level": {
          "type": "string",
          "enum": [
            "na",
            "0",
            "1",
            "2"
          ]
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crt",
        "cxx_runtime",
        "cxxabi_runtime",
        "sdk_abi_id"
      ],
      "properties": {
        "crt": {
          "type": "string",
          "enum": [
            "md-release",
            "md-debug",
            "mt-release",
            "mt-debug",
            "glibc",
            "musl",
            "bionic",
            "apple-libsystem"
          ]
        },
        "cxx_runtime": {
          "type": "string",
          "enum": [
            "msvc-stl-dynamic",
            "msvc-stl-static",
            "libcxx-shared",
            "libcxx-static",
            "ndk-libcxx-shared",
            "ndk-libcxx-static",
            "apple-libcxx-shared"
          ]
        },
        "cxxabi_runtime": {
          "type": "string",
          "enum": [
            "msvc",
            "libcxxabi-shared",
            "libcxxabi-static",
            "ndk-libcxxabi",
            "apple-libcxxabi"
          ]
        },
        "sdk_abi_id": {
          "type": "string",
          "pattern": "^(?:windows-sdk|linux-sysroot|android-ndk|macos-sdk|ios-sdk)-[a-z0-9][a-z0-9_.-]*(?![\\s\\S])"
        }
      }
    }
  },
